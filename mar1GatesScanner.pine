[g30_1, g30_2, g30_3, g30_4, g30_5, g30_6, g30_7, g30_8, h30_1, h30_2, h30_3, h30_4, h30_5, h30_6, h30_7, h30_8, lp30, cc30] = request.security(s30, timeframe.period, pairGates(flatOn, flatLen, flatLo, flatHi, flatWait), ignore_invalid_symbol = true)

// ---------------------------------------------------------------------------
// The finished series
// ---------------------------------------------------------------------------
// Unlike the two live tables, this one is written on EVERY bar rather than only
// the last: a closure is an event, and the only way to have the whole day by the
// time you look is to record each one as the script walks past it.
//
// Eight parallel arrays rather than one array of records, because Pine has no
// tuple array and this is the shape the renderer wants. Newest FIRST - unshift
// onto the front - which is both the order the table draws and the order the
// ageing loop below depends on.
var array<string> jSym  = array.new_string(0)
var array<int>    jGate = array.new_int(0)
var array<int>    jOpen = array.new_int(0)
var array<int>    jTime = array.new_int(0)
var array<int>    jEnt  = array.new_int(0)
var array<int>    jSide = array.new_int(0)
var array<int>    jStep = array.new_int(0)

// 1 on a row that closed as a CONTINUATION - the window took the pair over
// after the previous one closed, and the Entries cell already carries the
// RESTARTED count (see ccPk in pairGates); this flag is what hangs the ✚
// beside it.
var array<int>    jCont = array.new_int(0)

// The key the dedup RANKS by, which is not the key it DISPLAYS. jOpen is the
// first entry, because that is what a closed series is dated from in every file
// in this project. This is when the WINDOW opened - the green diamond - because
// that is what mar1Gates.pine draws at full strength, and the row kept here has
// to be the machine that chart led with or the two disagree about one morning.
// The same array, under the same name, for the same reason, in mar1Gates.pine.
var array<int>    jRank = array.new_int(0)

// The last closure counter seen on each of the two hundred and forty machines.
//
// This is how a closure is detected without a history reference. The obvious
// spelling is cnt != cnt[1] at each of the two hundred and forty call sites, and
// each of those is a series slot in a scope that allows twelve hundred
// variables. One array of two hundred and forty ints costs one name.
//
// Minus one means "never read", which is what stops the FIRST observation from
// counting as a change - every machine starts at zero and would otherwise log a
// phantom closure on the first bar of history.
var int[] lastCnt = array.new_int(240, -1)

// Scratch for the overlap resolution below: the rows of one episode, found on
// the way in. A global rather than a local, because logPair has thirty call
// sites and a `var` inside a function belongs to the call site - thirty arrays
// where one will do - and a plain local would allocate on every closure.
var int[] dupIdx = array.new_int(0)

// The exchange prefix is width and nothing else: every row in a one-broker list
// carries the same one.
shortName(string raw) =>
    parts = str.split(raw, ':')
    array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : raw

// One pair's eight slots, checked for a closure and recorded.
//
// A LOOP INSIDE ONE FUNCTION, not eight call sites, and the reason is the
// variable ceiling: Pine counts variables per scope and a call site is a scope
// instance. Two hundred and forty of these spelled out would be two hundred and
// forty scopes of unpacking. Nothing here is stateful per slot - lastCnt is a global array
// and an array is a reference - so the loop is free.
// TEMPORARY DIAGNOSTIC (2026-08-10) - remove this line and the two log.info
// blocks below once the missing-row investigation is done. A plain constant
// rather than an input, so flipping it costs no saved setting's position -
// same reasoning as LOG_ENTRY_TIMES above (edit the line, reload).
//
// OFF (2026-08-12) rather than deleted. Both blocks below build their line by
// string CONCATENATION, which is among the most expensive things a Pine script
// can do per bar, and DIAG-CLOSE runs the test across all two hundred and forty
// slots on every confirmed bar. With the constant false the bodies are never
// evaluated at all. Flip it back for one reload if the missing-row question
// comes up again, then flip it off.
diagLog = false

logPair(bool on, string raw, int pairIdx, float k1, float k2, float k3, float k4, float k5, float k6, float k7, float k8, float ccV) =>
    if on and raw != ''
        // var, split ONCE per call site rather than on every confirmed bar:
        // raw is an input string, constant for the whole run, and a var in a
        // function belongs to the call site - thirty pairs, thirty splits,
        // ever, instead of thirty per bar.
        var string nm = shortName(raw)
        // The continuation channel's own lastCnt: the closure counter inside
        // ccV, watched so one stamped closure attaches to exactly one row.
        // -1 keeps the first observation from counting, like lastCnt's -1.
        var int seenCC = -1
        for s = 0 to 7
            kv = s == 0 ? k1 : s == 1 ? k2 : s == 2 ? k3 : s == 3 ? k4 :
                 s == 4 ? k5 : s == 5 ? k6 : s == 6 ? k7 : k8
            if not na(kv)
                idx  = pairIdx * 8 + s
                c    = cCnt(kv)
                prev = array.get(lastCnt, idx)
                // TEMPORARY DIAGNOSTIC (2026-08-10) - every real cCnt change,
                // whether or not it survives the filter below.
                if diagLog and c != prev
                    log.info('DIAG-CLOSE;' + nm + ';s=' + str.tostring(s) + ';prev=' + str.tostring(prev) +
                         ';c=' + str.tostring(c) + ';firstObs=' + str.tostring(prev < 0) +
                         ';slotOn=' + str.tostring(slotOn(s)) +
                         ';inWindow=' + str.tostring(time_close >= periodFrom and time_close < periodTo) +
                         ';time_close=' + str.format_time(time_close, 'MM-dd HH:mm', 'UTC+1'))
                // A closure outside the window is not recorded at all, rather
                // than recorded and cleaned up afterwards. On the historical
                // pass that is most of them, and the arrays never hold what they
                // are about to throw away. The UPPER bound is what makes the
                // setting a window rather than a cutoff.
                // slotOn is tested HERE and not around the whole slot, because
                // lastCnt below has to keep tracking whatever the tick box says.
                // Skipping the counter as well would leave it frozen at the count
                // it held when the gate went off, and the first closure after it
                // was ticked back on would compare against a stale number and log
                // a window that had finished while nobody was listening.
                if prev >= 0 and c != prev and slotOn(s) and time_close >= periodFrom and time_close < periodTo
                    // The FIRST ENTRY of the window, rebuilt from the age the slot
                    // sent back, in whole minutes. The timestamp itself is 1.7e12
                    // and there is no room for one beside four other fields; a
                    // minute is exact on M1 and M3.
                    //
                    // Not the moment the gate opened - that is the live list's
                    // question and it is answered there. This log is about a
                    // series that cost something, so it is dated from the first
                    // thing that cost.
                    opened = time_close - cAgo(kv) * 60000

                    // And when the GATE opened, rebuilt the same way from the
                    // second age. This one is never printed - it only decides
                    // which machine keeps the row.
                    wOpened = time_close - cWAgo(kv) * 60000

                    // A CONTINUATION CLOSING (see ccPk in pairGates): the
                    // owner's window ended while its count stood restarted.
                    // The trade this row stands for began at the TAKEOVER -
                    // by the previous window's close - so it is dated and
                    // RANKED from there, and its entries are the restarted
                    // count: what was actually taken since that close, not
                    // the full depth of the window. The rung keeps the real
                    // depth, exactly as the chart keeps the mark's real
                    // colour under the small cross. Ranked at the takeover
                    // the row only TOUCHES the previous one, and touching is
                    // not overlapping, so the dedup leaves both standing.
                    isCont = ccClsS(ccV) == s and seenCC >= 0 and ccClsC(ccV) != seenCC
                    if isCont
                        opened := time_close - ccClsAgo(ccV) * 60000
                        wOpened := opened

                    // ONE PAIR, ONE EPISODE, ONE ROW - and the window that OPENED
                    // FIRST is the one that stays.
                    //
                    // THIS USED TO BE ONE ROW PER CLOSING MINUTE, which caught
                    // eight machines finishing the same win on the same candle
                    // and let this straight through:
                    //
                    //   GBPUSD  ◆ 27   12:00 -> 12:30   6 entries
                    //   GBPUSD  ◇ 30   12:05 -> 12:33   6 entries
                    //
                    // Two rows, twelve entries, two closures - for one stretch of
                    // one pair in which you were in exactly once. Different
                    // closing minutes, so nothing collapsed them, and the average
                    // on the header was fed both.
                    //
                    // YOU CANNOT BE IN TWO POSITIONS ON ONE PAIR. Once money is
                    // in on one gate, a second gate opening on the same symbol is
                    // not a trade you would take - it is the same money seen by
                    // another machine. A series that started while another was
                    // still running never happened as far as a ledger is
                    // concerned, and a row for it is a row for a trade nobody
                    // made. That is the whole of the rule, and it is an account
                    // of trading rather than a rule about candles.
                    //
                    // So: windows that OVERLAP on one symbol are one episode.
                    // The survivor is the earliest-opened, kept WHOLE - its gate,
                    // its entries, its side, its rung - because a row is one
                    // machine's account of a window and mixing the columns would
                    // describe a window none of the eight had. Anything that
                    // started inside it is not recorded, and a closure that
                    // started BEFORE rows already stored removes them and takes
                    // their place.
                    //
                    // Touching is not overlapping: a window opening on the candle
                    // another closed on is a second trade, because the first had
                    // already paid.
                    //
                    // RANKED BY THE OPENING, DATED BY THE FIRST ENTRY, which is
                    // also what makes this log and mar1Gates.pine's chart one
                    // sentence: that chart's leader claims the episode when it
                    // opens and holds it until it finishes, washing everything
                    // later out to 90. Full-strength mark there, row here; pale
                    // for its whole run, no row.
                    //
                    // The scan walks FORWARD from the newest row while its close
                    // is still after this window opened - the list is newest
                    // first, so closes only decrease and the walk ends by itself.
                    // More than one stored row can overlap even though no two
                    // stored rows overlap each other, since two short windows an
                    // hour apart both sit inside one long one that has only just
                    // finished, so every match is collected rather than the first.
                    array.clear(dupIdx)
                    int bestStored     = 0
                    int bestStoredSlot = -1
                    di = 0
                    while di < array.size(jTime) and array.get(jTime, di) > wOpened
                        if array.get(jSym, di) == nm
                            array.push(dupIdx, di)
                            r = array.get(jRank, di)
                            if bestStored == 0 or r < bestStored
                                bestStored     := r
                                bestStoredSlot := array.get(jGate, di)
                        di += 1

                    nd = array.size(dupIdx)

                    // The new closure takes the episode only if it opened
                    // strictly before every row it overlaps. On an EXACT tie -
                    // both windows opened on the literal same bar, which
                    // happens whenever gate mode is Off or several gates enter
                    // on the same rejection candle for the same pair - the tie
                    // is broken exactly the way mar1Gates.pine's chart leader
                    // is: the HIGHER slot wins, D before C before B before A
                    // and a gate's second length before its best. The two
                    // dedups have to agree on this or the log and the candles
                    // tell two different stories of the same morning.
                    newWins = nd == 0 or wOpened < bestStored or (wOpened == bestStored and s > bestStoredSlot)

                    // TEMPORARY DIAGNOSTIC (2026-08-10) - the dedup decision for
                    // every closure that passed the filter above.
                    if diagLog
                        log.info('DIAG-DEDUP;' + nm + ';s=' + str.tostring(s) +
                             ';wOpened=' + str.format_time(wOpened, 'MM-dd HH:mm', 'UTC+1') + ';nd=' + str.tostring(nd) +
                             ';bestStored=' + (bestStored > 0 ? str.format_time(bestStored, 'MM-dd HH:mm', 'UTC+1') : 'none') +
                             ';bestStoredSlot=' + str.tostring(bestStoredSlot) + ';newWins=' + str.tostring(newWins))

                    // Which stored row survives when the new one does not.
                    //
                    // dupIdx holds ASCENDING array indices and the list is newest
                    // first, so a larger index is an OLDER row. Walking q down
                    // from the end therefore goes oldest to newest, and taking
                    // only the FIRST match makes a tie keep the row that was
                    // already there - the same stability the other file has.
                    int keepIdx = -1
                    if nd > 0 and not newWins
                        for q = nd - 1 to 0
                            k = array.get(dupIdx, q)
                            if keepIdx < 0 and array.get(jRank, k) == bestStored
                                keepIdx := k

                    // Removed from the BACK of the collected list, which holds
                    // ascending indices, so every removal is at a position the
                    // earlier finds do not depend on.
                    if nd > 0
                        for q = nd - 1 to 0
                            k = array.get(dupIdx, q)
                            if k != keepIdx
                                array.remove(jSym, k)
                                array.remove(jGate, k)
                                array.remove(jOpen, k)
                                array.remove(jRank, k)
                                array.remove(jTime, k)
                                array.remove(jEnt, k)
                                array.remove(jSide, k)
                                array.remove(jStep, k)
                                array.remove(jCont, k)

                    if newWins
                        array.unshift(jSym, nm)
                        array.unshift(jGate, s)
                        array.unshift(jOpen, opened)
                        array.unshift(jRank, wOpened)
                        array.unshift(jTime, time_close)
                        // The restarted count IS the cost of a continued
                        // trade - the full window depth stays readable in
                        // the rung the row is painted with.
                        array.unshift(jEnt, isCont ? ccClsN(ccV) : cEnt(kv))
                        array.unshift(jSide, cSide(kv))
                        array.unshift(jStep, cStep(kv))
                        array.unshift(jCont, isCont ? 1 : 0)
                        if array.size(jSym) > jrnKeep
                            array.pop(jSym)
                            array.pop(jGate)
                            array.pop(jOpen)
                            array.pop(jRank)
                            array.pop(jTime)
                            array.pop(jEnt)
                            array.pop(jSide)
                            array.pop(jStep)
                            array.pop(jCont)
                array.set(lastCnt, idx, c)
        // Advanced OUTSIDE the per-slot filter, exactly like lastCnt: the
        // counter must move even when the row it stamped was filtered out
        // or eaten by the dedup, or the stamp would attach to some later
        // closure of the same slot.
        if ccClsC(ccV) != seenCC
            seenCC := ccClsC(ccV)
    array.size(jSym)

// Confirmed bars only, and this is the one guard the log cannot do without. Pine
// does not roll array contents back between realtime ticks, so a closure
// recorded on an unfinished candle would be recorded again on the next tick, and
// again, until the bar closed - one real event, fifty rows.
if barstate.isconfirmed
    // Ageing out, from the tail. The list is newest first, so the last element
    // is the oldest, and a while loop that pops until the tail is inside the
    // window handles both kinds of setting with the same lines: a rolling window
    // drops one row at a time as the clock moves, and a calendar one empties the
    // whole list at once when midnight moves the cutoff past every row in it.
    while array.size(jTime) > 0 and array.get(jTime, array.size(jTime) - 1) < periodFrom
        array.pop(jSym)
        array.pop(jGate)
        array.pop(jOpen)
        array.pop(jRank)
        array.pop(jTime)
        array.pop(jEnt)
        array.pop(jSide)
        array.pop(jStep)
        array.pop(jCont)

    // GENERATED - thirty log feeds.
    logPair(use01, sym01, 0, h01_1, h01_2, h01_3, h01_4, h01_5, h01_6, h01_7, h01_8, cc01)
    logPair(use02, sym02, 1, h02_1, h02_2, h02_3, h02_4, h02_5, h02_6, h02_7, h02_8, cc02)
    logPair(use03, sym03, 2, h03_1, h03_2, h03_3, h03_4, h03_5, h03_6, h03_7, h03_8, cc03)
    logPair(use04, sym04, 3, h04_1, h04_2, h04_3, h04_4, h04_5, h04_6, h04_7, h04_8, cc04)
    logPair(use05, sym05, 4, h05_1, h05_2, h05_3, h05_4, h05_5, h05_6, h05_7, h05_8, cc05)
    logPair(use06, sym06, 5, h06_1, h06_2, h06_3, h06_4, h06_5, h06_6, h06_7, h06_8, cc06)
    logPair(use07, sym07, 6, h07_1, h07_2, h07_3, h07_4, h07_5, h07_6, h07_7, h07_8, cc07)
    logPair(use08, sym08, 7, h08_1, h08_2, h08_3, h08_4, h08_5, h08_6, h08_7, h08_8, cc08)
    logPair(use09, sym09, 8, h09_1, h09_2, h09_3, h09_4, h09_5, h09_6, h09_7, h09_8, cc09)
    logPair(use10, sym10, 9, h10_1, h10_2, h10_3, h10_4, h10_5, h10_6, h10_7, h10_8, cc10)
    logPair(use11, sym11, 10, h11_1, h11_2, h11_3, h11_4, h11_5, h11_6, h11_7, h11_8, cc11)
    logPair(use12, sym12, 11, h12_1, h12_2, h12_3, h12_4, h12_5, h12_6, h12_7, h12_8, cc12)
    logPair(use13, sym13, 12, h13_1, h13_2, h13_3, h13_4, h13_5, h13_6, h13_7, h13_8, cc13)
    logPair(use14, sym14, 13, h14_1, h14_2, h14_3, h14_4, h14_5, h14_6, h14_7, h14_8, cc14)
    logPair(use15, sym15, 14, h15_1, h15_2, h15_3, h15_4, h15_5, h15_6, h15_7, h15_8, cc15)
    logPair(use16, sym16, 15, h16_1, h16_2, h16_3, h16_4, h16_5, h16_6, h16_7, h16_8, cc16)
    logPair(use17, sym17, 16, h17_1, h17_2, h17_3, h17_4, h17_5, h17_6, h17_7, h17_8, cc17)
    logPair(use18, sym18, 17, h18_1, h18_2, h18_3, h18_4, h18_5, h18_6, h18_7, h18_8, cc18)
    logPair(use19, sym19, 18, h19_1, h19_2, h19_3, h19_4, h19_5, h19_6, h19_7, h19_8, cc19)
    logPair(use20, sym20, 19, h20_1, h20_2, h20_3, h20_4, h20_5, h20_6, h20_7, h20_8, cc20)
    logPair(use21, sym21, 20, h21_1, h21_2, h21_3, h21_4, h21_5, h21_6, h21_7, h21_8, cc21)
    logPair(use22, sym22, 21, h22_1, h22_2, h22_3, h22_4, h22_5, h22_6, h22_7, h22_8, cc22)
    logPair(use23, sym23, 22, h23_1, h23_2, h23_3, h23_4, h23_5, h23_6, h23_7, h23_8, cc23)
    logPair(use24, sym24, 23, h24_1, h24_2, h24_3, h24_4, h24_5, h24_6, h24_7, h24_8, cc24)
    logPair(use25, sym25, 24, h25_1, h25_2, h25_3, h25_4, h25_5, h25_6, h25_7, h25_8, cc25)
    logPair(use26, sym26, 25, h26_1, h26_2, h26_3, h26_4, h26_5, h26_6, h26_7, h26_8, cc26)
    logPair(use27, sym27, 26, h27_1, h27_2, h27_3, h27_4, h27_5, h27_6, h27_7, h27_8, cc27)
    logPair(use28, sym28, 27, h28_1, h28_2, h28_3, h28_4, h28_5, h28_6, h28_7, h28_8, cc28)
    logPair(use29, sym29, 28, h29_1, h29_2, h29_3, h29_4, h29_5, h29_6, h29_7, h29_8, cc29)
    logPair(use30, sym30, 29, h30_1, h30_2, h30_3, h30_4, h30_5, h30_6, h30_7, h30_8, cc30)

// ---------------------------------------------------------------------------
// The tables
// ---------------------------------------------------------------------------
// One row per live pair in the grid, one column per slot, and the columns are in
// the same order the gate blocks are declared in - so the table reads the way
// the dialog does.
C_HEAD = #3B404A
C_ROWA = #1F242D
C_ROWB = #171B22
C_TXT  = #F2F6FA
C_DIM  = #5A6470
C_FOOT = #1A1E25
C_ENTRY = #24401A   // a cell that took an entry on the last closed bar
C_WARN  = #4A3B14   // a cell one step from opening on the last closed bar

// THE EIGHT GLYPHS, one per machine, and they are the shapes mar1Gates.pine
// draws on the candles - not a parallel alphabet that has to be translated.
//
// They used to be four gate glyphs, filled for the best length and hollow for
// the second, on the argument that a table has no sizes. That was true while the
// chart had four shapes; the chart has eight now, and a scanner naming a machine
// differently from the chart it is a scanner FOR is one mapping too many to hold
// in the head.
//
//   ▲ A best    ⬆ A second     ⚑ C best    ◆ C second
//   ● B best    ■ B second     ☀ D best    ❄ D second
//
// ▲ AND ⬆ ARE DIRECTIONAL AND THE SIDE ARROW IS TOO, so a short on GATE A
// reads '▲▼' or '⬆▼' - glyph one way, side the other. Both pointing shapes sit
// on gate A on purpose: it is currently the loosest gate in the set, it fires
// most often, and it was asked to be the one the eye finds first. That is a real cost and it
// was weighed against the alternative: it is the SAME symbol on the chart and in
// the table, which is what was asked for. The glyph is
// always the leftmost character of a cell and the arrow always follows it, so
// the position says which is which even when the two disagree.
GLYPH_A1 = '▲'
GLYPH_A2 = '⬆'
GLYPH_B1 = '●'
GLYPH_B2 = '■'
GLYPH_C1 = '⚑'
GLYPH_C2 = '◆'
GLYPH_D1 = '☀'
GLYPH_D2 = '❄'

slotGlyph(int s) => s == 0 ? GLYPH_A1 : s == 1 ? GLYPH_A2 : s == 2 ? GLYPH_B1 : s == 3 ? GLYPH_B2 :
     s == 4 ? GLYPH_C1 : s == 5 ? GLYPH_C2 : s == 6 ? GLYPH_D1 : GLYPH_D2
slotLen(int s)   => s == 0 ? lenA1 : s == 1 ? lenA2 : s == 2 ? lenB1 : s == 3 ? lenB2 :
     s == 4 ? lenC1 : s == 5 ? lenC2 : s == 6 ? lenD1 : lenD2

// WHICH GATE a slot belongs to, read live from the inputs rather than written
// out as a literal. Two columns share a gate - the best length and the second -
// so the number is the same for slots 0 and 1, for 2 and 3, and so on.
//
// The same three functions, under the same names, in mar1Gates.pine. A gate
// edited to 97 has to say 97 in both files or one of them is describing a
// setting nobody is running.
gatePct(int s)   => s < 2 ? pctA : s < 4 ? pctB : s < 6 ? pctC : pctD
gateMin(int s)   => s < 2 ? minA : s < 4 ? minB : s < 6 ? minC : minD
gateTxt(int s)   => str.tostring(gatePct(s), '#.##') + '/' + str.tostring(gateMin(s))

posOf(string nm) => nm == 'Top right' ? position.top_right :
     nm == 'Middle right' ? position.middle_right :
     nm == 'Bottom right' ? position.bottom_right :
     nm == 'Top center' ? position.top_center :
     nm == 'Middle center' ? position.middle_center :
     nm == 'Bottom center' ? position.bottom_center :
     nm == 'Top left' ? position.top_left :
     nm == 'Middle left' ? position.middle_left :
     nm == 'Bottom left' ? position.bottom_left : position.middle_right

txtSize = txtSizeName == 'Normal' ? size.normal : txtSizeName == 'Tiny' ? size.tiny : size.small
txtSizeBig = txtSizeName == 'Normal' ? size.large : txtSizeName == 'Tiny' ? size.small : size.normal

// The ladder again, as a ROW background rather than as text, and this is what
// makes the live list readable at a glance instead of readable by column. Copied
// from mar1Scanner.pine, transparency argument included.
//
// The top step gets 25 less transparency than it is asked for: red is the one
// hue that has to stay loud when everything around it is a wash.
stepFill(int step, int transp) =>
    step == 1 ? color.new(color.white, transp) :
     step == 2 ? color.new(#22C55E, transp) :
     step == 3 ? color.new(#15803D, transp) :
     step == 4 ? color.new(#166534, transp) :
     step == 5 ? color.new(#EA580C, transp) :
     step == 6 ? color.new(#DC2626, transp > 25 ? transp - 25 : 0) :
     // The terminal step gets the same "loud" treatment the old red step had:
     // less transparency than the caller asked for, because a run six entries
     // deep is the last thing on either table that should blend in.
     step == 8 ? color.new(#450A0A, transp > 25 ? transp - 25 : 0) :
     step == 7 ? color.new(color.silver, 80) :
     color.new(#333333, 60)

// Only white needs black text. The 700-900 shades the gradient runs on are all
// dark enough on their own to take white, deep tones being the point of them.
stepText(int step) =>
    step == 1 ? color.black : color.white

// Counters a function has to be able to move. A Pine function cannot assign to a
// global, and an array is a reference - which is the one way to count something
// from inside one.
//
//   0  grid rows drawn
//   1  slots scanned
//   2  slots that came back na, which means the ticker did not resolve
//   3  live pairs hidden because nothing was happening on any of their eight
//   4  live pairs standing aside for a flat right now
var int[] tally = array.new_int(5, 0)

// Per-column summaries, filled as the rows are drawn: how many pairs have an
// open window on this slot, and the deepest one of them. A column of quiet cells
// and a column with one nine-entry window look alike from across the desk, and
// the footer is what tells them apart.
var int[] colOpen = array.new_int(8, 0)
var int[] colDeep = array.new_int(8, 0)
var int[] colFire = array.new_int(8, 0)

// The RUNNING list, gathered before it is drawn.
//
// It has to be gathered because it is SORTED, and it is sorted because the
// question it answers is "what is deepest", which no fixed row order can show.
// Running, armed and pre-armed all land in the same arrays and are separated by
// rState alone - see the note at the top of the file on why they are one list.
var int[]   rSlot = array.new_int(0)
var int[]   rEnt  = array.new_int(0)
var int[]   rStep = array.new_int(0)
var int[]   rAgo  = array.new_int(0)
var int[]   rStk  = array.new_int(0)
var int[]   rThr  = array.new_int(0)
var int[]   rDir  = array.new_int(0)
var int[]   rState = array.new_int(0)
var string[] rName = array.new_string(0)

// The LIVE PREVIEW digit for this row's own slot - 0 nothing, 1 warning long,
// 2 warning short, 3 entry long, 4 entry short, 5 IN long, 6 IN short. See
// livePkAt and LIVE PREVIEW near the foot of the file.
var int[]   rLive = array.new_int(0)

// Whether the PAIR this row belongs to is standing aside for a flat. Per row
// rather than per pair only because the renderer walks rows; every row of one
// pair carries the same answer, since the verdict is measured off price alone.
var bool[]  rFlat = array.new_bool(0)

// Whether this row's slot is the PAIR'S ACTIVE one - the slot whose window
// opened FIRST and is still open, pre-armed only when nothing is open, an
// exact tie to the higher slot. The same answer mar1Gates.pine's RUNNING arrow
// and its solid chart mark give (user rule, 2026-08-20).
var bool[]  rAct = array.new_bool(0)
// The restarted entry count for the row's slot - non-zero only on the row of
// a pair's owner while its trade is a continuation. See ccPk in pairGates.
var int[]   rCont = array.new_int(0)

// The sort key, packed the same way everything else here is: state first so the
// three groups never interleave, then entries, then how long it has been open.
//
//   state x 1e10   3 running, 2 armed, 1 pre-armed
//   ent   x 1e6    up to 999
//   ago   x 1      up to 9999 minutes
var float[] rKey = array.new_float(0)

// Declared for thirty pairs plus two header rows and two footer rows. The
// declared size has to exceed every index ever written, or the write is an
// out-of-bounds error that kills the script rather than a cell quietly going
// missing.
var table gTable = table.new(posOf(gridPos), 9, 36, border_width = 1)

// Two headers, up to forty rows, one footer. SIXTEEN columns, not eight: the
// rows run in two side-by-side blocks of eight columns each, 0-7 and 8-15, so
// twenty-one rows stand eleven tall instead of twenty-one.
var table rTable = table.new(posOf(runPos), 16, 44, border_width = 2)

// Four blocks of six columns with a gap between them, two headers and up to
// sixty rows per block.
LOG_BLOCKS = 4
LOG_TALL   = 60

// HOW MANY of those blocks the log may use, where rows per column decides how
// TALL each one is. Together they are the whole of what the table shows - rows
// times blocks - and the header prints the product, so the two never have to be
// multiplied in your head.
//
// Declared HERE rather than beside its partner four hundred lines up, and for
// two reasons that happen to agree. It needs LOG_BLOCKS for its own ceiling, and
// LOG_BLOCKS is the line above. And TradingView maps a saved setting onto an
// input by POSITION: every other input in this file is declared above this
// point, so appending here is the one place a new input costs nobody a reset.
// The dialog lays inputs out by their group, not by where they sit in the file,
// so this still appears under Tables beside the rows-per-column it belongs with.
logCols = input.int(0, 'Closed log: blocks side by side (0 = auto)', minval = 0, maxval = LOG_BLOCKS, group = gOut,
     tooltip = 'How many columns of the log stand beside each other. 0 uses all four. One block with a tall rows-per-column gives a single long list; two of thirty is the same sixty rows in half the width. Together with rows per column this is the whole of the layout - the header says which shape it ended up with whenever either is set by hand.', display = display.none)

var table lTable = table.new(posOf(logPos), LOG_BLOCKS * 7 - 1, LOG_TALL + 2, border_width = 1)

// One grid cell. Everything it can say is in here, and it is deliberately one
// place: eight columns times thirty rows is two hundred and forty of these, and a
// rule that lived in the caller would have to be right two hundred and forty
// times.
// AN UNTICKED COLUMN IS NOT DRAWN AT ALL - not blanked, not dimmed, not written.
// A table column nothing is ever written into collapses to nothing on screen, so
// the eight columns become six and the grid closes up behind the gate that went
// away. A column of dots would have kept the width and told you every pair was
// idle on a machine that is simply not being asked.
//
// col is 1..8 and the slot is one less, because column 0 is the pair name.
// act marks the pair's ACTIVE slot - see the pre-pass in scanPair.
gCell(int col, int r, string glyph, float v, color rowBg, bool act, int cont) =>
    if slotOn(col - 1)
        ent   = uEnt(v)
        step  = uStep(v)
        dir   = uDir(v)
        fired = uFire(v)
        wopen = uOpen(v)

        // A cell speaks when something is open, something just fired, or the gate
        // is one step from opening. Everything else is a machine sitting still,
        // and a grid this wide only works if sitting still looks like nothing.
        //
        // wopen is in this test and used not to be, which was a hole rather than
        // a preference: a window opened by a green diamond has ZERO entries, so
        // an ARMED slot was indistinguishable from an idle one and the pair
        // counted as quiet. Armed is the state most worth seeing, because it is
        // the last one before the window starts costing money.
        show = ent > 0 or fired > 0 or step == 1 or wopen == 1
        arrow = dir == 2 ? '▲' : dir == 1 ? '▼' : ''
        txt = not show ? ' · ' : ' ' + glyph + arrow + (ent > 0 ? str.tostring(ent) : wopen == 1 ? '°' : '') + (cont > 0 ? ' ✚' + str.tostring(cont) : '') + (act ? ' ◀' : '') + ' '
        bg = fired == 2 ? C_ENTRY : fired == 1 ? C_WARN : rowBg

        table.cell(gTable, col, r, txt, bgcolor = bg,
             text_color = show ? stepColor(step) : C_DIM, text_size = txtSize)

// One pair: it counts, it collects for the RUNNING list, and it draws the grid
// row. All three in one pass because all three read the same eight numbers, and a
// second pass over them is a second chance to disagree about what they say.
//
// na is tested through the first value alone: ignore_invalid_symbol makes the
// whole tuple na at once, so one test settles all eight.
//
// GENERATED signature and body.
scanPair(bool on, string raw, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8, float v9, float vC) =>
    live = on and raw != ''
    if live
        array.set(tally, 1, array.get(tally, 1) + 1)
        if na(v1)
            array.set(tally, 2, array.get(tally, 2) + 1)
        // NOTHING IS REPORTED ON A TIMEFRAME THE GRID HAS NO LENGTHS FOR, and
        // that has to be ENFORCED here rather than only said in the footer.
        //
        // It was only said. On a 3-minute chart the footer read NOTHING IS
        // REPORTED ON THIS TIMEFRAME while the table underneath listed USDCAD
        // pre-armed - a state the machines had genuinely reached, using the
        // 1-MINUTE lengths on 3-minute candles, because the lengths have to be
        // something and tfOk was consulted by the bridge and by every header but
        // not by the collection. digitFor published 1 for every pair, so the
        // browser line said the scanner was publishing nothing at the same
        // moment as the table showed a row.
        //
        // Counted as scanned, because it was, and then as hidden, which is where
        // every other pair with nothing to say already goes.
        else if not tfOk
            array.set(tally, 3, array.get(tally, 3) + 1)
        else
            // var - raw is a constant input, so the split runs once per call
            // site ever instead of once per pair per tick. Same string.
            var string nm = shortName(raw)

            // Counted before the quiet test, and deliberately: a pair standing
            // aside for a flat usually HAS nothing open and would be hidden, so
            // counting it inside the visible rows would report almost none of
            // them. This is a count of the watchlist, not of the table.
            if livePkFlat(v9)
                array.set(tally, 4, array.get(tally, 4) + 1)

            // THE PAIR'S ACTIVE SLOT - the gate that got there first: the open
            // window with the most time on it, pre-armed only when nothing is
            // open, an exact tie to the highest slot. The same key
            // mar1Gates.pine's arrow, its solid mark and both closed logs rank
            // by (user rule, 2026-08-20).
            //
            // uAgo is minutes since the window opened, so the OLDEST window is
            // the LARGEST number. The packed live value carries no timestamp and
            // needs none: the question is who was here first, and an age answers
            // that as well as a clock does.
            //
            // Ascending s with >= on the age keeps the highest slot when two
            // windows are the same number of minutes old - which on the
            // timeframes this file runs on is the same candle, the tie-break the
            // other files use.
            //
            // Pre-armed slots all carry age 0 - openAgo is only stamped for an
            // open window - so tier 1 falls back to the slot alone. The chart
            // ranks those by whiteSince, which nothing here transports; the
            // difference can only show between two pre-armed gates on a pair
            // with nothing open.
            int actS    = -1
            int actTier = 0
            int actAgo  = -1
            for s = 0 to 7
                if slotOn(s)
                    va = s == 0 ? v1 : s == 1 ? v2 : s == 2 ? v3 : s == 3 ? v4 :
                         s == 4 ? v5 : s == 5 ? v6 : s == 6 ? v7 : v8
                    tr = uEnt(va) > 0 or uOpen(va) == 1 ? 2 : uStep(va) == 1 ? 1 : 0
                    ag = uAgo(va)
                    if tr > 0 and (actS < 0 or tr > actTier or (tr == actTier and ag >= actAgo))
                        actTier := tr
                        actAgo  := ag
                        actS    := s

            // The pair's continuation, unpacked once per pair: the owner
            // slot and the restarted entry count, 0 when the running trade
            // is not a continuation. See ccPk in pairGates.
            contLiveN = ccLiveN(vC)
            contLiveS = ccLiveS(vC)

            // Quiet means every one of the eight is sitting still. Worked out
            // before the row is placed, because a hidden row must not consume a
            // row index - that is how a table ends up with a gap in it.
            quiet = true
            for s = 0 to 7
                // AN UNTICKED GATE IS SKIPPED WHOLE, and everything downstream
                // follows from that one test rather than from four of them: it
                // takes no place in the live list, adds nothing to the per-slot
                // open and deepest counters, and cannot keep a pair on the grid
                // by being the only thing on the row that is not quiet.
                //
                // That last one is the reason this sits around the whole body
                // instead of only around the push. A pair whose sole activity is
                // on a gate you have switched off is a QUIET pair, and a row
                // drawn for it would be a row of empty cells.
                if slotOn(s)
                    vv = s == 0 ? v1 : s == 1 ? v2 : s == 2 ? v3 : s == 3 ? v4 :
                         s == 4 ? v5 : s == 5 ? v6 : s == 6 ? v7 : v8
                    e  = uEnt(vv)
                    f  = uFire(vv)
                    st = uStep(vv)
                    wo = uOpen(vv)
                    if e > 0 or f > 0 or st == 1 or wo == 1
                        quiet := false
                    if e > 0
                        array.set(colOpen, s, array.get(colOpen, s) + 1)
                        if e > array.get(colDeep, s)
                            array.set(colDeep, s, e)
                    if f > 0
                        array.set(colFire, s, array.get(colFire, s) + 1)

                    // Three states, one list. The order is by how far along the
                    // slot is, not by which name the state has.
                    stt = e > 0 ? 3 : wo == 1 ? 2 : st == 1 ? 1 : 0

                    // A near-miss win (7/8, see livePk in gateOne) resets the
                    // streak the same instant it happens, so stt alone would
                    // already be back at 0 by the time this runs - the row
                    // would never be pushed and the event would leave no
                    // trace anywhere in the table. Forced in here rather than
                    // folded into stt itself, because it is not a fourth
                    // STATE the way running/armed/pre-armed are - it is a
                    // one-bar flash with nothing behind it.
                    lv = livePkAt(v9, s)
                    if stt > 0 or lv == 7 or lv == 8
                        array.push(rName, nm)
                        array.push(rSlot, s)
                        array.push(rEnt, e)
                        array.push(rStep, st)
                        array.push(rAgo, uAgo(vv))
                        array.push(rStk, uStk(vv))
                        array.push(rThr, uThr(vv))
                        array.push(rDir, uDir(vv))
                        array.push(rState, stt)
                        array.push(rKey, 1.0 * stt * 10000000000 + e * 1000000 + uAgo(vv))
                        array.push(rLive, lv)
                        array.push(rFlat, livePkFlat(v9))
                        array.push(rAct, s == actS)
                        array.push(rCont, s == contLiveS ? contLiveN : 0)

            if quiet and not showQuiet
                array.set(tally, 3, array.get(tally, 3) + 1)
            else if showGrid
                drawn = array.get(tally, 0)
                r = drawn + 2
                array.set(tally, 0, drawn + 1)
                rowBg = drawn % 2 == 0 ? C_ROWA : C_ROWB
                table.cell(gTable, 0, r, ' ' + nm + ' ', bgcolor = rowBg,
                     text_color = C_TXT, text_size = txtSize)
                gCell(1, r, GLYPH_A1, v1, rowBg, actS == 0, contLiveS == 0 ? contLiveN : 0)
                gCell(2, r, GLYPH_A2, v2, rowBg, actS == 1, contLiveS == 1 ? contLiveN : 0)
                gCell(3, r, GLYPH_B1, v3, rowBg, actS == 2, contLiveS == 2 ? contLiveN : 0)
                gCell(4, r, GLYPH_B2, v4, rowBg, actS == 3, contLiveS == 3 ? contLiveN : 0)
                gCell(5, r, GLYPH_C1, v5, rowBg, actS == 4, contLiveS == 4 ? contLiveN : 0)
                gCell(6, r, GLYPH_C2, v6, rowBg, actS == 5, contLiveS == 5 ? contLiveN : 0)
                gCell(7, r, GLYPH_D1, v7, rowBg, actS == 6, contLiveS == 6 ? contLiveN : 0)
                gCell(8, r, GLYPH_D2, v8, rowBg, actS == 7, contLiveS == 7 ? contLiveN : 0)
    array.get(tally, 0)

if barstate.islast
    // Each behind its own tick box (2026-08-12). Both ran unconditionally, so a
    // chart with the grid switched off still wiped three hundred and twenty
    // four cells of it on every realtime tick, and one with the live list off
    // wiped another three hundred and fifty two. A table nothing is ever
    // written into has nothing to clear.
    if showGrid
        // Rows 0-1 are the header, built entirely from inputs - constant for
        // the whole run - so they are drawn ONCE behind gHdrDrawn below, and
        // the per-tick clear starts at row 2 instead of wiping and rebuilding
        // them on every tick.
        table.clear(gTable, 0, 2, 8, 35)
    if showRun
        // Row 1 is the column headings - constant labels and tooltips, drawn
        // once behind rHdrDrawn in the live-list block - so the clear skips it:
        // the dynamic header row 0 and the data rows from 2 down.
        table.clear(rTable, 0, 0, 15, 0)
        table.clear(rTable, 0, 2, 15, 43)
    for k = 0 to 4
        array.set(tally, k, 0)
    for s = 0 to 7
        array.set(colOpen, s, 0)
        array.set(colDeep, s, 0)
        array.set(colFire, s, 0)
    array.clear(rName)
    array.clear(rSlot)
    array.clear(rEnt)
    array.clear(rStep)
    array.clear(rAgo)
    array.clear(rStk)
    array.clear(rThr)
    array.clear(rDir)
    array.clear(rState)
    array.clear(rKey)
    array.clear(rLive)
    array.clear(rFlat)
    array.clear(rAct)
    array.clear(rCont)

    // The header, and the one thing it has to be able to say is that the chart
    // is on a timeframe the grid has no lengths for - in which case every number
    // under it would be a length measured somewhere else.
    hdBg = tfOk ? #0E2A1B : #553300
    var bool gHdrDrawn = false
    if showGrid and not gHdrDrawn
        gHdrDrawn := true
        table.cell(gTable, 0, 0,
             (tfOk ? ' MAR1 GATES · SCANNER  ·  ' + timeframe.period + ' column ' :
              ' MAR1 GATES · SCANNER  ·  ' + timeframe.period + ' IS NOT ' + TF_LIVE + ' - the grid has no lengths for this timeframe ') +
             (restrictToHours ? ' ·  ' + str.tostring(startHour) + '-' + str.tostring(endHour) + ' UTC+1 ' : ' ·  all hours '),
             bgcolor = hdBg, text_color = tfOk ? #6EF0A5 : #FFC163, text_size = txtSize)
        for k = 1 to 8
            table.cell(gTable, k, 0, '', bgcolor = hdBg, text_size = txtSize)
        table.merge_cells(gTable, 0, 0, 8, 0)

        // Column titles carry the glyph, the GATE and the length, so a cell never
        // has to be decoded from memory.
        //
        // The gate in brackets is what closes the last gap. The glyph named the
        // gate only if you already knew which glyph belonged to which numbers,
        // and the length beside it is the one number that is NOT the gate - so a
        // header reading '◆ 19' put the two things a cell is about behind one
        // remembered mapping. '◆ <length> (<pct>/<min>)' needs nothing remembered.
        //
        // Two columns share a gate, the best length and the second, so the
        // bracket repeats down each PAIR of columns. That repetition is the point:
        // it is what draws the eight columns into four groups by eye.
        //
        // Read live through gateTxt rather than written out, so a gate edited in
        // the dialog cannot leave a header claiming the number it shipped with.
        hdTip = 'A cell speaks only when something is happening: an open window, a signal on the last closed bar, or the gate one step from opening. The glyph names the gate, the arrow the side, the number the entries the open window has cost, a small circle a window that is open but has cost nothing yet, and the colour the rung of the ladder. A green background is an entry on the last closed bar, amber a warning.'
        table.cell(gTable, 0, 1, ' Pair ', bgcolor = C_HEAD, text_color = C_TXT, text_size = txtSize, tooltip = hdTip)
        // A LOOP, where this was eight spelled-out calls. The tick box has to be
        // consulted for each column and eight copies of one test is eight places
        // for it to be different; every part of a title is already available from
        // slotGlyph, slotLen and gateTxt, which are the same functions the cells
        // and both other tables read, so nothing is lost by building it.
        for s = 0 to 7
            if slotOn(s)
                table.cell(gTable, s + 1, 1, ' ' + slotGlyph(s) + ' ' + str.tostring(slotLen(s)) + ' (' + gateTxt(s) + ') ',
                     bgcolor = C_HEAD, text_color = C_TXT, text_size = txtSize,
                     tooltip = 'Gate ' + (s < 2 ? 'A' : s < 4 ? 'B' : s < 6 ? 'C' : 'D') + ', ' + gateTxt(s) + ', ' +
                          (s % 2 == 0 ? 'best length on this timeframe.' : 'second length.'))

    // GENERATED - thirty scanPair calls, ten packed floats each.
    scanPair(use01, sym01, g01_1, g01_2, g01_3, g01_4, g01_5, g01_6, g01_7, g01_8, lp01, cc01)
    scanPair(use02, sym02, g02_1, g02_2, g02_3, g02_4, g02_5, g02_6, g02_7, g02_8, lp02, cc02)
    scanPair(use03, sym03, g03_1, g03_2, g03_3, g03_4, g03_5, g03_6, g03_7, g03_8, lp03, cc03)
    scanPair(use04, sym04, g04_1, g04_2, g04_3, g04_4, g04_5, g04_6, g04_7, g04_8, lp04, cc04)
    scanPair(use05, sym05, g05_1, g05_2, g05_3, g05_4, g05_5, g05_6, g05_7, g05_8, lp05, cc05)
    scanPair(use06, sym06, g06_1, g06_2, g06_3, g06_4, g06_5, g06_6, g06_7, g06_8, lp06, cc06)
    scanPair(use07, sym07, g07_1, g07_2, g07_3, g07_4, g07_5, g07_6, g07_7, g07_8, lp07, cc07)
    scanPair(use08, sym08, g08_1, g08_2, g08_3, g08_4, g08_5, g08_6, g08_7, g08_8, lp08, cc08)
    scanPair(use09, sym09, g09_1, g09_2, g09_3, g09_4, g09_5, g09_6, g09_7, g09_8, lp09, cc09)
    scanPair(use10, sym10, g10_1, g10_2, g10_3, g10_4, g10_5, g10_6, g10_7, g10_8, lp10, cc10)
    scanPair(use11, sym11, g11_1, g11_2, g11_3, g11_4, g11_5, g11_6, g11_7, g11_8, lp11, cc11)
    scanPair(use12, sym12, g12_1, g12_2, g12_3, g12_4, g12_5, g12_6, g12_7, g12_8, lp12, cc12)
    scanPair(use13, sym13, g13_1, g13_2, g13_3, g13_4, g13_5, g13_6, g13_7, g13_8, lp13, cc13)
    scanPair(use14, sym14, g14_1, g14_2, g14_3, g14_4, g14_5, g14_6, g14_7, g14_8, lp14, cc14)
    scanPair(use15, sym15, g15_1, g15_2, g15_3, g15_4, g15_5, g15_6, g15_7, g15_8, lp15, cc15)
    scanPair(use16, sym16, g16_1, g16_2, g16_3, g16_4, g16_5, g16_6, g16_7, g16_8, lp16, cc16)
    scanPair(use17, sym17, g17_1, g17_2, g17_3, g17_4, g17_5, g17_6, g17_7, g17_8, lp17, cc17)
    scanPair(use18, sym18, g18_1, g18_2, g18_3, g18_4, g18_5, g18_6, g18_7, g18_8, lp18, cc18)
    scanPair(use19, sym19, g19_1, g19_2, g19_3, g19_4, g19_5, g19_6, g19_7, g19_8, lp19, cc19)
    scanPair(use20, sym20, g20_1, g20_2, g20_3, g20_4, g20_5, g20_6, g20_7, g20_8, lp20, cc20)
    scanPair(use21, sym21, g21_1, g21_2, g21_3, g21_4, g21_5, g21_6, g21_7, g21_8, lp21, cc21)
    scanPair(use22, sym22, g22_1, g22_2, g22_3, g22_4, g22_5, g22_6, g22_7, g22_8, lp22, cc22)
    scanPair(use23, sym23, g23_1, g23_2, g23_3, g23_4, g23_5, g23_6, g23_7, g23_8, lp23, cc23)
    scanPair(use24, sym24, g24_1, g24_2, g24_3, g24_4, g24_5, g24_6, g24_7, g24_8, lp24, cc24)
    scanPair(use25, sym25, g25_1, g25_2, g25_3, g25_4, g25_5, g25_6, g25_7, g25_8, lp25, cc25)
    scanPair(use26, sym26, g26_1, g26_2, g26_3, g26_4, g26_5, g26_6, g26_7, g26_8, lp26, cc26)
    scanPair(use27, sym27, g27_1, g27_2, g27_3, g27_4, g27_5, g27_6, g27_7, g27_8, lp27, cc27)
    scanPair(use28, sym28, g28_1, g28_2, g28_3, g28_4, g28_5, g28_6, g28_7, g28_8, lp28, cc28)
    scanPair(use29, sym29, g29_1, g29_2, g29_3, g29_4, g29_5, g29_6, g29_7, g29_8, lp29, cc29)
    scanPair(use30, sym30, g30_1, g30_2, g30_3, g30_4, g30_5, g30_6, g30_7, g30_8, lp30, cc30)

    drawn      = array.get(tally, 0)
    scanned    = array.get(tally, 1)
    unresolved = array.get(tally, 2)
    hidden     = array.get(tally, 3)

    // Signals on the last closed bar, summed over the eight slots. The cells
    // already show these one at a time with a coloured background; this is the
    // number that says whether to go looking for them at all, and it counts the
    // hidden rows too - a quiet pair is one with nothing OPEN, which is not the
    // same as one that did nothing.
    firedTotal = 0
    for s = 0 to 7
        firedTotal += array.get(colFire, s)

    if showGrid
        // The summary row, directly under the last pair. Open windows per slot
        // and the deepest of them - which is the column that says whether a
        // quiet-looking gate is quiet or simply carrying one very long run.
        sumRow = drawn + 2
        table.cell(gTable, 0, sumRow, ' open · deepest ', bgcolor = C_FOOT, text_color = C_TXT, text_size = txtSize,
             tooltip = 'Per slot: how many pairs have a window open right now, and the most entries any one of them has cost. A slot with few windows and a deep one is the shape that breaks a recovery ladder.')
        for s = 0 to 7
            if slotOn(s)
                op = array.get(colOpen, s)
                dp = array.get(colDeep, s)
                table.cell(gTable, s + 1, sumRow, op > 0 ? ' ' + str.tostring(op) + ' · ' + str.tostring(dp) + ' ' : ' · ',
                     bgcolor = C_FOOT, text_color = op > 0 ? stepColor(depthStep(dp)) : C_DIM, text_size = txtSize)

        // The footer, and the three things it shouts are the three that mean a
        // number above is not what it appears to be.
        footRow = drawn + 3
        table.cell(gTable, 0, footRow,
             ' ' + str.tostring(scanned) + ' pairs scanned' +
             // Whenever the grid is narrower than eight columns, why. A missing
             // column is otherwise indistinguishable from a gate that has nothing
             // to say, and the two mean opposite things.
             (gatesLive < 8 ? '  ·  ' + str.tostring(8 - gatesLive) + ' SLOTS UNTICKED' : '') +
             (firedTotal > 0 ? '  ·  ' + str.tostring(firedTotal) + ' signals on the last bar' : '') +
             (drawn < scanned - unresolved ? '  ·  ' + str.tostring(hidden) + ' quiet, hidden' : '') +
             (unresolved > 0 ? '  ·  ' + str.tostring(unresolved) + ' UNRESOLVED' : '') +
             (scanBars > 0 ? '  ·  CAPPED AT ' + str.tostring(scanBars) + ' BARS PER PAIR' : '') +
             (not tfOk ? '  ·  NOTHING IS REPORTED ON THIS TIMEFRAME' : '') +
             '  ·  ' + str.tostring(bar_index + 1) + ' bars of history ',
             bgcolor = C_FOOT, text_color = unresolved > 0 or not tfOk ? #FFC163 : #C9D1DA, text_size = txtSize)
        for k = 1 to 8
            table.cell(gTable, k, footRow, '', bgcolor = C_FOOT, text_size = txtSize)
        table.merge_cells(gTable, 0, footRow, 8, footRow)

        if drawn == 0
            table.cell(gTable, 0, 2, ' nothing open on any of the eight ', bgcolor = C_ROWA,
                 text_color = C_DIM, text_size = txtSize)

// ---------------------------------------------------------------------------
// THE LIST - what is in, and what is about to be
// ---------------------------------------------------------------------------
// This is mar1Scanner.pine's open table, column for column, with ONE column
// added. It is the main table of this file and the grid above is an extra that
// ships switched off.
//
// Two tables were the mistake. The grid answers "which of two hundred and forty
// machines are doing anything", which is a question you ask once while setting
// the thing up; the list answers "what do I act on now", which is the question
// you ask every minute. Splitting those across two tables meant reading both and
// reconciling them by eye, and a scanner that has to be reconciled is not a
// scanner.
//
//   Pair          the symbol
//   Gate          WHICH of the eight, and the only column mar1Scanner has no need
//                 of - there a row is a pair, here a pair carries eight machines
//                 and a row without this would be one of eight anonymous twins
//   State         RUNNING / ARMED / pre-armed
//   Market        IN while a position is live on the candle now forming
//   Entries       what the open window has cost
//   Open since    when the gate opened, UTC+1
//   Streak / gate consecutive failures against the threshold
//   Last          the side
//
// THE ROW IS THE LADDER, and that is the whole reason this reads at a glance.
// The background of the row is the rung, not the colour of one cell in it: a
// purple row is a window three past its anchor and you know that before reading
// a single number. Same scale, same six hues, as the diamonds on the chart.
//
// AND A PRE-ARMED ROW IS A WASH. White at 88 - barely lit - because it is not a
// position: nothing is open, nothing has cost anything, and it reaches no log.
// It is there so a gate one step from opening can be watched BEFORE it starts
// costing, which is the whole of what "prepare for it" means. White rather than
// some fourth colour of its own, because white is already what the ladder calls
// one step short of the gate - the diamond this row is reporting is literally a
// white diamond. One colour, one meaning, on the chart and in the table.
if barstate.islast and showRun
    n = array.size(rKey)

    nRun = 0
    nArm = 0
    nPre = 0
    if n > 0
        for i = 0 to n - 1
            st = array.get(rState, i)
            if st == 3
                nRun += 1
            else if st == 2
                nArm += 1
            else
                nPre += 1

    shownRun = n < runMax ? n : runMax
    // TWO BLOCKS, eight columns each. The list stays one sorted list - the left
    // block is ranks 1..rowsPerCol read top to bottom, the right one carries on
    // from there - so the deepest row is still the top left cell. Odd counts put
    // the extra row on the left, which is the half that holds the deep end.
    rowsPerCol = int(math.ceil(shownRun / 2.0))

    hdBg = not tfOk ? #553300 : nRun > 0 ? #4A3B14 : #0E2A1B
    table.cell(rTable, 0, 0,
         (not tfOk ? ' MAR1 GATES · SCANNER  ·  ' + timeframe.period + ' IS NOT ' + TF_LIVE + ' ' :
          n == 0 ? ' MAR1 GATES · SCANNER  ·  NOTHING OPEN ' :
          ' MAR1 GATES · ' + str.tostring(nRun) + ' RUNNING   ' + str.tostring(nArm) + ' ARMED ' +
          (nPre > 0 ? '  ·  ' + str.tostring(nPre) + ' pre-armed ' : '')) +
         (shownRun < n ? ' ·  top ' + str.tostring(shownRun) + ' of ' + str.tostring(n) + ' ' : '') +
         // NOTHING OPEN reads the same whether the eight machines are quiet or
         // half of them are switched off, and those are opposite states. The
         // count is on the line that already says what is running.
         (gatesLive < 8 ? ' ·  ' + str.tostring(gatesLive) + ' of 8 slots live ' : '') +
         (restrictToHours ? ' ·  ' + str.tostring(startHour) + '-' + str.tostring(endHour) + ' UTC+1 ' : ' ·  all hours '),
         bgcolor = hdBg, text_color = not tfOk ? #FFC163 : nRun > 0 ? #FFD98A : #6EF0A5, text_size = txtSize)
    for k = 1 to 15
        table.cell(rTable, k, 0, '', bgcolor = hdBg, text_size = txtSize)
    table.merge_cells(rTable, 0, 0, 15, 0)

    // The column headings are repeated over BOTH blocks - a right-hand block
    // reading under the left one's headings is a table you have to count across
    // to use. b is 0 for the left block and 8 for the right.
    //
    // Short labels and no padding spaces (2026-08-12): two blocks side by side
    // is twice the width, so every column that can be named in four or five
    // characters is. What the heading meant in full lives in its tooltip, which
    // did not change.
    //
    // Drawn ONCE - labels and tooltips are constants, the per-tick clear above
    // skips this row, so rebuilding sixteen cells of it per tick bought nothing.
    var bool rHdrDrawn = false
    if not rHdrDrawn
        rHdrDrawn := true
        for b = 0 to 8 by 8
            table.cell(rTable, b + 0, 1, 'Pair', bgcolor = color.gray, text_color = color.white, text_size = txtSize)
            table.cell(rTable, b + 1, 1, 'Gate', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'Which of the eight machines this row belongs to - the SAME glyph it wears on the chart, and the MA length it is running on this timeframe. ▲ ⬆ gate A, ● ■ gate B, ⚑ ◆ gate C, ☀ ❄ gate D - the first of each pair is the best length, the second is the control. ▲ and ⬆ are the two machines that draw a pointing shape on the chart, so on a short their glyph and the side arrow beside it face opposite ways: the glyph is always first, the arrow always second.')
            table.cell(rTable, b + 2, 1, 'State', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'RUNNING - entries taken, none has paid yet. ARMED - the gate is open, no entry yet. pre-armed - one step short of the anchor, so the next marker would come out white. Nothing is open on a pre-armed gate and none of it reaches the closed log; it is there to be watched before it costs anything.')
            table.cell(rTable, b + 3, 1, 'Mkt', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'Whether a position is live on the candle now forming. An entry grades exactly one candle - taken at its open, settled at its close - so IN lasts one candle, while RUNNING can stand for an hour across candles you were flat for. The word flat here means the opposite of a position: the pair is inside a stretch that went nowhere, so no entry is being taken on any of its eight gates. White pre-armed and dark green ARMED are the same states the State column names, given the same big plate for as long as they hold, not just a row tint - nothing is at risk on either, there is simply nothing else on screen that says so as plainly as IN does. A pale ≈ won is a warn signal - one short of the gate - that matched the candle anyway: no window ever opened and nothing was risked, but the direction would have paid; it shows for one bar only, because the streak resets and there is no state left to hold a plate open.')
            table.cell(rTable, b + 4, 1, 'Ent', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'What the open window has cost so far. This is the number a recovery ladder dies on, and it is what the list is sorted by inside each state.')
            table.cell(rTable, b + 5, 1, 'Since', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'When the gate opened - the green diamond, or the first entry when the streak gate is Off. UTC+1, to the minute: the age travels back from the pair as a whole number of minutes, not as a timestamp.')
            table.cell(rTable, b + 6, 1, 'Stk/g', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'Streak / gate. Consecutive failures against the threshold that opens the gate. On a pre-armed row this is the whole of what the row says: one short.')
            table.cell(rTable, b + 7, 1, 'Side', bgcolor = color.gray, text_color = color.white, text_size = txtSize,
                 tooltip = 'The side the last entry of this window was taken on - the arrow alone, up for long and down for short. Blank while nothing has been entered.')

    if n > 0
        // Sorted here rather than kept sorted, because the list is rebuilt from
        // scratch on the last bar and one sort of a few dozen rows costs less
        // than an ordered insert per row.
        ord = array.sort_indices(rKey, order.descending)
        for i = 0 to shownRun - 1
            j  = array.get(ord, i)
            st = array.get(rState, j)
            e  = array.get(rEnt, j)
            ag = array.get(rAgo, j)
            dr = array.get(rDir, j)
            ld = array.get(rStep, j)
            // BOTH READ FROM rLive NOW, not from rFire. mkt used to be
            // array.get(rFire, j) == 2 - the SAME firedNow that gCell and the
            // grid still use, and that was the bug: firedNow is a `var`
            // written only `if barstate.isconfirmed`, so for the whole of the
            // NEXT bar's formation it kept the stamp from the bar BEFORE that -
            // one full candle stale, on a table that re-renders every tick. A
            // graded entry lasting exactly one candle was showing up on the
            // candle after the one it belonged to, and if that candle carried
            // no rejection of its own, IN was on when nothing was happening.
            //
            // 5 and 6 are buyTaken / sellTaken themselves, packed fresh every
            // tick - see livePk in gateOne. mkt still wins over the preview
            // text below it, because a graded entry is a firmer fact than a
            // pattern still forming.
            //
            // The rFire ARRAY named above is gone (2026-08-12): once this was
            // its only reader it was being filled on every live row of every
            // redraw for nobody. The grid's own firedNow, which it reads
            // straight out of the packed number, is untouched - that one is
            // correct there, since the grid only ever describes the last closed
            // bar.
            lv = array.get(rLive, j)
            mkt = lv == 5 or lv == 6

            // Standing aside for a flat. It cannot collide with anything else in
            // the Market column: entries and the preview are both gated by the
            // same flatOk, so while this is true mkt is false and liveTxt empty.
            // A row that keeps its entry count while saying flat is the paused
            // ladder - deferred, not abandoned.
            isFlat = array.get(rFlat, j)
            liveTxt = lv == 3 ? '~entry▲' : lv == 4 ? '~entry▼' : lv == 1 ? '~warn▲' : lv == 2 ? '~warn▼' :
                 lv == 7 ? '≈won▲' : lv == 8 ? '≈won▼' : ''

            pre  = st == 1
            // stt (pushed as rState) can be 0 here without this being a real
            // pre-armed row - see the near-miss push in scanPair. blank is
            // what pre used to gate alone; it now covers that flash row too,
            // so Entries and Opened since stay empty instead of printing a
            // borrowed zero and the current time.
            blank = pre or st == 0
            word = st == 3 ? 'RUNNING' : st == 2 ? 'ARMED' : st == 1 ? 'pre-armed' : ''

            // stepText is not consulted on a pre-armed row. It returns black for
            // the light rungs, and a wash at 88 is not a light background - black
            // on it would be the one unreadable row in the table.
            rowBg = pre ? color.new(color.white, 88) : stepFill(ld, 55)
            rowFg = pre ? color.new(color.white, 30) : stepText(ld)

            // The direction keeps its own colour, but it has to survive a light
            // row: lime on lime and red on white are both unreadable. Same hue,
            // darkened. The top step needs its own pair for the same reason in
            // reverse - a red arrow on a red row is invisible, and the row is
            // already carrying the alarm. Only step 1 (pure white) needs it now -
            // the gradient runs on 700-900 shades (2026-08-10), dark enough on
            // their own for the default arrow colours to read fine, the same
            // as step 6 and 8 already did.
            light  = not pre and ld == 1
            hot    = not pre and (ld == 6 or ld == 8)
            sideFg = dr == 2 ? (light ? color.new(#006622, 0) : hot ? #B9F6CA : color.lime) :
                 dr == 1 ? (light ? color.new(#991111, 0) : hot ? #FFFFFF : color.red) :
                 (light ? color.new(#444444, 0) : color.silver)

            // Left block for the first rowsPerCol ranks, right block for the
            // rest, each starting again at the row under the headings. c is the
            // block's first column, so every cell below is c + its old index.
            left = i < rowsPerCol
            c = left ? 0 : 8
            r = (left ? i : i - rowsPerCol) + 2

            // NO PADDING SPACES anywhere below (2026-08-12). Every cell used to
            // carry a leading and trailing space, which is two characters of
            // width on eight columns, and there are two blocks of them now.
            table.cell(rTable, c + 0, r, array.get(rName, j), bgcolor = rowBg, text_color = rowFg, text_size = txtSize)
            // The glyph gets a column of its own rather than sharing one with the
            // length, and it is drawn at the largest text size the table has. It
            // is the one cell that says WHICH machine, eight of them are live on
            // every symbol, and at the same size as its neighbours it was the
            // easiest thing on the row to miss.
            table.cell(rTable, c + 1, r, slotGlyph(array.get(rSlot, j)) + str.tostring(slotLen(array.get(rSlot, j))) + (array.get(rCont, j) > 0 ? ' ✚' + str.tostring(array.get(rCont, j)) : '') + (array.get(rAct, j) ? ' ◀' : ''),
                 bgcolor = rowBg, text_color = rowFg, text_size = txtSizeBig)
            table.cell(rTable, c + 2, r, word, bgcolor = rowBg, text_color = rowFg, text_size = txtSize)
            // BIG AND BRIGHT, no blink, whenever a position is live on the
            // forming candle (IN) or that candle is currently offering an entry,
            // a warning or a near-miss (liveTxt). Those are gated to the forming
            // candle alone - IN by buyTaken/sellTaken's own one-candle life,
            // liveTxt by barstate.isrealtime and not barstate.isconfirmed or by
            // the [1]-offset near-miss digits - so neither needs a timer of its
            // own: each is on for exactly as long as the fact it reports is
            // true, and gone the instant the candle closes.
            //
            // PRE-ARMED and ARMED get the same big plate, but for as long as the
            // STATE holds rather than for one bar - st is read straight off the
            // row's own pushed state on every redraw, so it needs no timer
            // either (user report, 2026-08-10: pre-armed used to be a blank
            // Market cell and armed only a row tint, both easy to miss entirely
            // when a slot passes through them in a single candle).
            // armedIdle singles out the one case that needs its own colour: an
            // open window with nothing entered yet is real, but nothing is at
            // risk on it - it must not share the bright green IN already means
            // "money is live right now".
            armedIdle = st == 2 and not mkt and liveTxt == ''
            //
            // Capped at txtSizeBig (the same size the glyph column already
            // uses), not size.huge - with up to 8 rows, huge on every one of
            // them at once pushed the table taller than the chart (user
            // report, 2026-08-10).
            //
            // isFlat is excluded here even though it can coincide with st == 2
            // (an armed window paused mid-flat keeps its state, per the flat
            // filter's own rule) - the flat text below is a small, calm cell on
            // purpose, and the plate is what pre-armed/armed earn once trading
            // is actually live for them again.
            bigOn = mkt or liveTxt != '' or ((st == 2 or st == 1) and not isFlat)
            bigBg = mkt ? color.new(#00E676, 0) : (lv == 3 or lv == 4) ? color.new(#CCFF00, 0) :
                 (lv == 7 or lv == 8) ? color.new(#F5F5F5, 0) : (lv == 1 or lv == 2) ? color.new(#FFC107, 0) :
                 // Light blue rather than cyan (user request, 2026-08-10) -
                 // Material Blue 300, which sits in the true-blue family rather
                 // than the cyan-leaning Light Blue one.
                 armedIdle ? color.new(#64B5F6, 0) : color.new(#F5F5F5, 0)
            bigFg = color.black
            table.cell(rTable, c + 3, r,
                 mkt ? '●IN' : isFlat ? 'flat' : liveTxt != '' ? liveTxt :
                 st == 2 ? 'ARMED' : st == 1 ? 'pre-armed' : blank ? '' : 'wait',
                 bgcolor = bigOn ? bigBg : rowBg, text_color = bigOn ? bigFg : rowFg, text_size = bigOn ? txtSizeBig : txtSize)
            table.cell(rTable, c + 4, r, e > 0 ? str.tostring(e) : blank ? '' : '-',
                 bgcolor = rowBg, text_color = rowFg, text_size = txtSize)
            table.cell(rTable, c + 5, r, blank ? '' : str.format_time(time - ag * 60000, 'MM-dd HH:mm', 'UTC+1'),
                 bgcolor = rowBg, text_color = rowFg, text_size = txtSize)
            table.cell(rTable, c + 6, r, str.tostring(array.get(rStk, j)) + '/' + str.tostring(array.get(rThr, j)),
                 bgcolor = rowBg, text_color = rowFg, text_size = txtSize)
            // The arrow ALONE, no word beside it. Up is long and down is short
            // everywhere else in this script and on the chart itself, so the
            // word was a second copy of what the glyph already said, in the one
            // place where two blocks of columns are competing for width.
            table.cell(rTable, c + 7, r, dr == 2 ? '▲' : dr == 1 ? '▼' : '',
                 bgcolor = rowBg, text_color = sideFg, text_size = txtSize)

        // An odd count leaves the right block one row short of the left one.
        // Unwritten cells are transparent, so with a border on the table that
        // shows as a hole punched in the bottom corner rather than as a row
        // that simply is not there. Filled dark to close it.
        if shownRun - rowsPerCol < rowsPerCol
            for k = 8 to 15
                table.cell(rTable, k, rowsPerCol + 1, '', bgcolor = C_ROWA, text_size = txtSize)
    else
        table.cell(rTable, 0, 2, tfOk ? ' nothing open on any of the two hundred and forty ' : ' the grid has no lengths for this timeframe ',
             bgcolor = C_ROWA, text_color = C_DIM, text_size = txtSize)
        for k = 1 to 15
            table.cell(rTable, k, 2, '', bgcolor = C_ROWA, text_size = txtSize)
        table.merge_cells(rTable, 0, 2, 15, 2)

    // The footer, and it belongs to THIS table now.
    //
    // It used to hang off the grid, which was fine while the grid was the main
    // table and is not now that the grid ships off - the one screen you look at
    // would have had no footer at all. That matters more here than it looks:
    // with nothing open, this table is one line saying NOTHING OPEN, which is
    // indistinguishable from a script that was never added, never resolved a
    // symbol, or quietly died. A clock that moves and a count of what was
    // actually scanned turns that into a positive statement - it is working, and
    // the answer is nothing.
    // The footer sits under the TALLER of the two blocks, which is the left one.
    footRow = (n > 0 ? rowsPerCol : 1) + 2
    table.cell(rTable, 0, footRow,
         ' scanned ' + str.tostring(array.get(tally, 1)) + ' pairs' +
         // How much of the watchlist is standing aside right now. Without it a
         // quiet screen reads the same whether nothing is triggering or the flat
         // filter is holding half the list back, and those are opposite facts.
         (array.get(tally, 4) > 0 ? '  ·  ' + str.tostring(array.get(tally, 4)) + ' FLAT, standing aside' : '') +
         (array.get(tally, 2) > 0 ? '  ·  ' + str.tostring(array.get(tally, 2)) + ' UNRESOLVED' : '') +
         (scanBars > 0 ? '  ·  CAPPED AT ' + str.tostring(scanBars) + ' BARS PER PAIR' : '') +
         (not tfOk ? '  ·  NOTHING IS REPORTED ON THIS TIMEFRAME' : '') +
         '  ·  ' + str.format_time(timenow, 'HH:mm:ss', 'UTC+1') + ' ',
         bgcolor = array.get(tally, 2) > 0 or not tfOk ? color.new(color.red, 60) : color.new(#333333, 60),
         text_color = array.get(tally, 2) > 0 or not tfOk ? color.white : color.silver, text_size = txtSize)
    for k = 1 to 15
        table.cell(rTable, k, footRow, '', bgcolor = array.get(tally, 2) > 0 or not tfOk ? color.new(color.red, 60) : color.new(#333333, 60), text_size = txtSize)
    table.merge_cells(rTable, 0, footRow, 15, footRow)

// ---------------------------------------------------------------------------
// CLOSED - the finished series
// ---------------------------------------------------------------------------
// mar1Scanner.pine's log with one column added. There a row is a pair, here it
// is a pair AND a gate, and the gate is the column that has to be there - eight
// machines close windows on the same symbol and without it the log would be eight
// interleaved lists wearing one name.
//
// ONE ROW PER PAIR PER EPISODE. Windows that OVERLAP on one symbol are one
// episode - you cannot be in two positions on one pair, so a series that started
// while another was still running is the same money seen by a second machine -
// and only the one that OPENED first is kept, whole, with its gate, its entries
// and its side. That is the same machine mar1Gates.pine leads with on the chart,
// so a bright mark there has a row here and a mark that stayed pale has none.
// The choosing happens on the way IN, up in logPair, so what this table counts
// and averages is what it draws.
//
// Newest first, wrapping into blocks beside each other rather than growing down.
// Width is the direction a chart has to spare.
// ---------------------------------------------------------------------------
// HOW BIG THE CLOSED LOG IS DRAWN
// ---------------------------------------------------------------------------
// Its own size, separate from every other table, and the reason is that this one
// is read differently from the others. The live tables are glanced at - a row
// appears, you act on it, it goes. The closed log is READ BACK: rows compared
// against each other, times lined up against the chart, an average at the top
// that two settings get judged by. Those are opposite needs, and one setting
// could not serve both - shrinking the log to fit a day of closures shrank the
// live list with it, and enlarging the live list pushed the log off the screen.
//
// 'Same as the tables' is the default and keeps exactly the old behaviour, so
// nothing moves for anyone who does not go looking for this.
//
// DECLARED HERE, at the foot, below every other input in the file. TradingView
// maps a saved setting onto an input by POSITION, so a new input anywhere above
// this line slides every setting under it onto a value saved against something
// else. At the bottom it costs nobody anything. The dialog lays inputs out by
// their GROUP rather than by file order, so it still appears beside the rest of
// the log's settings.
logTxtName = input.string('Same as the tables', 'CLOSED log: text size',
     options = ['Same as the tables', 'Tiny', 'Small', 'Normal', 'Large'], group = gOut,
     tooltip = 'The finished-series log only. Every other table keeps the shared Text size setting above. Use this to fit more rows on screen, or to make a log you are reading back legible without enlarging the live tables with it.', display = display.none)

logTxt = logTxtName == 'Tiny' ? size.tiny : logTxtName == 'Small' ? size.small :
     logTxtName == 'Normal' ? size.normal : logTxtName == 'Large' ? size.large : txtSize

// One tier up, for the Gate column alone - the same relationship txtSizeBig has
// to txtSize, kept intact so the glyph stays the largest thing on a row.
logTxtBig = logTxtName == 'Tiny' ? size.small : logTxtName == 'Small' ? size.normal :
     logTxtName == 'Normal' ? size.large : logTxtName == 'Large' ? size.huge : txtSizeBig

if barstate.islast and showLog != 'Hidden'
    rows = array.size(jSym)

    // Read once and named, because four separate places below ask it, and four
    // separate spellings of the same test is how one of them ends up different.
    full = showLog == 'Full list'

    // CLEARED ONLY IN Full list (2026-08-12), and it is the reorder rather than
    // the test that had to happen - this call used to sit above `full` and so
    // could not consult it. The region is twenty-six columns by sixty-one rows,
    // which is more than fifteen hundred cells wiped on EVERY realtime tick,
    // and in the default Summary only mode not one of them is ever written.
    //
    // Safe because an input cannot change without the script reloading from
    // scratch: a run that is in Summary only was in Summary only from its first
    // bar, so no row was ever drawn under the header and there is nothing stale
    // left to clear. In Full list the clear stays exactly as it was, since the
    // row count moves with the window.
    if full
        table.clear(lTable, 0, 0, LOG_BLOCKS * 7 - 2, LOG_TALL + 1)

    // The total is what makes the log more than a list: entries divided by
    // closures is the average cost of a win across the whole watchlist, which is
    // the number the streak gate exists to bring down - and the same number
    // maSweepPairs.pine sweeps for.
    //
    // Over ALL rows on purpose, not the drawn ones. An average taken over
    // whatever happened to fit on screen is not an average of anything; it would
    // move when the text size changed.
    // CACHED between bar closes (the var block below): the j* arrays only move
    // inside the confirmed-bar recorder above, so walking every row and
    // rebuilding the by-cost string on every realtime tick produced the same
    // numbers tick after tick. Recomputed on each confirmed bar - and once on
    // first draw - reused in between.
    var int      totalEntC = 0
    var string   costTxtC  = ''
    var bool     sumDone   = false

    // AND THE SHAPE THE AVERAGE HIDES, which is the whole reason this histogram
    // sits beside it.
    //
    // One number cannot describe a recovery ladder. Two settings can both average
    // 2.3 entries a win and be nothing alike: one that pays two almost every time
    // is survivable, and one that pays one most of the time and eight
    // occasionally is not. The ladder dies on the TAIL, and the mean is exactly
    // where a tail goes to hide - a handful of very deep windows move it by a
    // tenth and move the account by everything.
    //
    // Seven buckets: how many closures cost one entry, two, three, four, five,
    // and everything past five in one. Six-plus is open-ended on purpose - once a
    // window is that deep the exact number stops changing the decision.
    //
    // ZERO IS A BUCKET TOO, and it is printed only when it is not empty. A window
    // can open on a green diamond and be closed by the very next signal without
    // anything having been entered: it costs nothing, it is a real closure, and it
    // is already pulling the average down. Printing 0x0 on every ordinary day
    // would be noise, so it appears only when there is something to explain.
    //
    // Counted over ALL rows in the window, exactly like the average above it, and
    // not over the rows that happened to fit on screen. Across thirty pairs that
    // difference is most of the log.
    var int[] costHist = array.new_int(7, 0)
    if barstate.isconfirmed or not sumDone
        sumDone   := true
        totalEntC := 0
        array.fill(costHist, 0)
        if rows > 0
            for i = 0 to rows - 1
                costE = array.get(jEnt, i)
                totalEntC += costE
                costB = costE < 0 ? 0 : costE > 6 ? 6 : costE
                array.set(costHist, costB, array.get(costHist, costB) + 1)
        // The by-cost line, rebuilt in the same pass - see the bucket notes
        // below, which describe exactly what this string carries.
        costTxtC := ''
        if rows > 0
            costTxtC := '  ·  by cost'
            for cb = 0 to 6
                costN = array.get(costHist, cb)
                if cb > 0 or costN > 0
                    costTxtC := costTxtC + '  ' + (cb == 6 ? '6+' : str.tostring(cb)) + '×' + str.tostring(costN) +
                         ' (' + str.tostring(100.0 * costN / rows, '#') + '%)'

    // EACH BUCKET CARRIES ITS SHARE AS WELL AS ITS COUNT, because a count on its
    // own is only comparable inside one window. Twelve windows won on the first
    // entry is most of a quiet morning and a fraction of a busy one, so the count
    // answers "how much sample is behind this" and the percentage answers "what
    // is the shape" - and the shape is the half that survives being held against
    // yesterday, or against the same log with one setting moved.
    //
    // Rounded to whole percent, so the buckets can add to 99 or to 101. That is
    // the rounding and not a miscount: the counts beside them are exact and they
    // are what sum to the closure total on the left of the line.
    // Every bucket from one upwards is printed even when it is empty, so the
    // positions hold still and two logs can be compared by shape rather than by
    // reading the labels each time. Zero is the exception and appears only when
    // it has something in it. Built in the cached pass above; read here.
    totalEnt = totalEntC
    costTxt  = costTxtC

    // The block count first, because the automatic row height is derived from
    // it: asking for two blocks and letting the rows size themselves has to
    // spread the closures over two, not over four and then draw half of them.
    maxBlocks = logCols <= 0 ? LOG_BLOCKS : logCols
    autoRows = rows <= 0 ? 20 : int(math.ceil(rows / (1.0 * maxBlocks)))
    autoRows := autoRows < 20 ? 20 : autoRows > LOG_TALL ? LOG_TALL : autoRows
    colRows = logPerCol <= 0 ? autoRows : logPerCol
    drawCap = colRows * maxBlocks
    shown   = rows < drawCap ? rows : drawCap
    blocks  = shown <= 0 ? 1 : int(math.ceil(shown / math.max(colRows, 1)))
    blocks := blocks > maxBlocks ? maxBlocks : blocks
    hdrSpan = blocks * 7 - 2

    // The window names its own bounds rather than saying "custom", and that is
    // not decoration: it is the one place that proves the setting arrived. Pin
    // 09:00 and if this line still says TODAY, the script is not reading it.
    //
    // Formatted from the RESULTING timestamps rather than rebuilt from the
    // inputs, which is what makes it a check instead of an echo - it can catch
    // the date picker having landed somewhere other than where you thought,
    // since the picker works in exchange time and this prints UTC+1.
    //
    // periodTo is the first moment PAST the window, so a stretch ending exactly
    // at midnight would be dated for a day it never reaches. Backing off a
    // millisecond asks about the last moment the window actually contains.
    pinFromDay = str.format_time(periodFrom, 'yyyy-MM-dd', 'UTC+1')
    pinEndDay  = str.format_time(periodTo - 1, 'yyyy-MM-dd', 'UTC+1')

    // The second clause is the whole-day case, which the day comparison alone
    // gets wrong: a day starting at midnight ends at the next midnight, whose
    // last contained moment is still the SAME day, so a naive test says no
    // crossing and the label comes out '00:00-00:00' for a window a day wide.
    pinCrosses = spanMs > 0 and (spanMs >= dayMs or pinEndDay != pinFromDay)
    pinToday   = pinFromDay == str.format_time(timenow, 'yyyy-MM-dd', 'UTC+1')
    pinLabel   = str.format_time(periodFrom, pinToday and not pinCrosses ? 'HH:mm' : 'MM-dd HH:mm', 'UTC+1') +
         (spanMs > 0 ? '-' + str.format_time(periodTo, pinCrosses ? 'MM-dd HH:mm' : 'HH:mm', 'UTC+1') : ' ONWARDS')

    periodName = jrnLength == 'Day' and not datePinned ? 'TODAY' :
         jrnLength == 'Week' and not datePinned ? 'THIS WEEK' :
         jrnLength == 'Everything' and not datePinned ? 'LOGGED' :
         pinned ? pinLabel :
         'LAST ' + str.tostring(lengthHours, '#.##') + 'H'

    // The date is read ONLY when the anchor says to read it, so under the other
    // two anchors the picker is inert - and inert silently, which is the whole
    // problem: nothing on screen distinguished a date that was applied from one
    // that was ignored. Compared against the default rather than shown whenever
    // the anchor is wrong, or it would be permanent for everyone who has never
    // opened the picker.
    dateIgnored = not datePinned and jrnFrom != JRN_FROM_DEFAULT

    hdBg = dateIgnored ? color.new(#553300, 15) : color.new(#12261A, 15)
    table.cell(lTable, 0, 0,
         ' CLOSED ' + periodName + '  ·  ' + str.tostring(rows) + ' closed' +
         // Five decimals, and they are for RANKING rather than for reading. One
         // decimal is all the precision this number has - a few hundred closures
         // put its own error bar at roughly +/-0.07 - so 2.1 is the honest way to
         // state it on its own. The use here is comparing one setting against
         // another by changing it and reading this line twice, and at one decimal
         // two settings differing by 0.09 both print 2.1. The digits separate
         // them; they do not make the separation real.
         (rows > 0 ? '  ·  ' + str.tostring(totalEnt) + ' entries, ' + str.tostring(1.0 * totalEnt / rows, '#.00000') + ' avg' : '') +
         costTxt +
         // WHICH MACHINES THIS AVERAGE IS OF. The number on this line is the one
         // maSweepPairs.pine sweeps and the one two settings get compared by, so
         // an average taken over six slots must never be mistaken for an average
         // taken over eight. Unticking a gate now genuinely removes it from the
         // log, which is what makes saying so necessary.
         (gatesLive < 8 ? '  ·  ' + str.tostring(gatesLive) + ' of 8 slots' : '') +
         (full and rows > shown ? '  ·  newest ' + str.tostring(shown) + ' listed' : '') +
         // The shape, whenever either half of it was typed rather than worked
         // out. A layout setting that leaves no trace on screen is one you
         // cannot prove arrived, which is the whole reason the window prints its
         // own bounds two lines down.
         (full and (logPerCol > 0 or logCols > 0) ? '  ·  ' + str.tostring(blocks) + ' x ' + str.tostring(colRows) + ' by hand' : '') +
         (jrnCap <= 0 and rows >= JRN_KEEP_MAX ? '  ·  AT THE ' + str.tostring(JRN_KEEP_MAX) + ' ROW CEILING - older closures dropped' : '') +
         (dateIgnored ? "  ·  DATE IGNORED - set 'Window anchored' to Starting at date" : '') + ' ',
         bgcolor = hdBg, text_color = dateIgnored ? color.orange : #7CE0A5, text_size = logTxt,
         tooltip = 'by cost is the distribution behind the average: 1× is how many windows were won on the first entry, 2× on the second, and so on, with 6+ collecting everything deeper, each followed by its share of the whole window in brackets. The average to its left is the same closures in one number and it cannot show a tail - two settings with an identical average can have completely different shapes here, and it is the tail a recovery ladder dies on. The shares are rounded to whole percent and can sum to 99 or 101; the counts beside them are exact. A 0× bucket appears only when a window closed without anything having been entered.')

    // The header is one long sentence, and in column 0 alone it would make column
    // 0 as wide as that sentence - which is why the left block's Pair column used
    // to stand three times the width of the right block's on the same six-letter
    // names. Merging spreads it across the columns the list actually uses.
    if full and shown > 0
        for k = 1 to hdrSpan
            table.cell(lTable, k, 0, '', bgcolor = hdBg, text_size = logTxt)
        table.merge_cells(lTable, 0, 0, hdrSpan, 0)

    // One header row per block that has something under it. Drawing all four
    // unconditionally would leave three sets of column titles standing over
    // nothing whenever the day was quiet.
    //
    // Seven, not six: column 6 of each block is the gap. Block 0 owns 0-5,
    // block 1 owns 7-12, and so on.
    if full
        for b = 0 to blocks - 1
            h = b * 7
            table.cell(lTable, h + 0, 1, ' Pair ',    bgcolor = color.gray, text_color = color.white, text_size = logTxt)
            table.cell(lTable, h + 1, 1, ' Gate ',    bgcolor = color.gray, text_color = color.white, text_size = logTxt,
                 tooltip = 'Which of the eight machines closed this window - the same glyph and length the grid and the chart use. Overlapping windows on one pair are ONE episode and get ONE row, because you cannot be in two positions on one symbol: whichever gate OPENED first is the one you would have been in, so it is the one kept, and anything that started inside it is not recorded at all. That is the same machine mar1Gates.pine draws at full strength while it washes the other seven out - a series drawn bright there has a row here, one that stayed pale has none.')
            table.cell(lTable, h + 2, 1, ' Opened ',  bgcolor = color.gray, text_color = color.white, text_size = logTxt,
                 tooltip = 'When the FIRST ENTRY of that window was taken - not when the gate opened, which can be a quarter of an hour earlier and had cost nothing yet. UTC+1, to the minute. The gate opening is still sent and is what decides which machine keeps the row, but it is not printed: a closed series is dated from the first thing that cost, and that is the time maRejection.pine stamps too. The live list dates its rows from the gate instead, because it is asked a different question: since when has this slot been demanding attention.')
            table.cell(lTable, h + 3, 1, ' Closed ',  bgcolor = color.gray, text_color = color.white, text_size = logTxt,
                 tooltip = 'Closing time of the winning candle, UTC+1.')
            table.cell(lTable, h + 4, 1, ' Entries ', bgcolor = color.gray, text_color = color.white, text_size = logTxt,
                 tooltip = 'How many entries that window cost, the winning one included. Coloured by the rung it closed on - the same ladder the diamonds wear. A ✚ marks a continued trade: the previous window on the pair had closed, this one took the pair over, and the number is the entries taken from that takeover on - not the full depth of the window, which the row colour still shows.')
            table.cell(lTable, h + 5, 1, ' Side ',    bgcolor = color.gray, text_color = color.white, text_size = logTxt)

    // i is both the drawn position and the stored one: the array is descending by
    // closing time by construction, because logPair unshifts each closure onto
    // the front as it arrives. Nothing to sort.
    //
    // math.floor with an explicit int(), and this is the line that breaks a table
    // into a staircase when it is written the obvious way. Pine's / returns a
    // FLOAT even between two ints, so i / colRows comes out 0.05, 0.30, 1.20 -
    // and a column index of 1.2 is not one column over, it is a fifth of the way
    // there. The row is derived from the same floored block for the same reason:
    // one expression decides both, so they cannot disagree.
    if full and shown > 0
        for i = 0 to shown - 1
            g    = array.get(jGate, i)
            en   = array.get(jEnt, i)
            enCont = array.get(jCont, i)
            sd   = array.get(jSide, i)
            rung = array.get(jStep, i)
            blk  = int(math.floor(i / math.max(colRows, 1)))
            c    = blk * 7
            rr   = i - blk * colRows + 2

            // THE ROW IS THE RUNG IT CLOSED ON, which is what makes this log and
            // the live list one story rather than two. A pair sits in the list as
            // a purple row, closes, and reappears here as the same purple row.
            // Nothing changes colour on the way across, so a finished series can
            // be recognised as the one that was being watched.
            //
            // Deeper transparency than the live list on purpose - 62 against 55.
            // This is history and must not compete for attention with a window
            // still open.
            rowBg = stepFill(rung, 62)
            rowFg = stepText(rung)

            // Same hue, darkened on a light rung and paled on the top one: lime
            // on lime and red on red are both invisible, and on the red step the
            // row already carries the alarm. Only rung 1 needs the light
            // treatment now - see the same note in THE LIST above.
            light  = rung == 1
            hot    = rung == 6 or rung == 8
            sideFg = sd == 2 ? (light ? color.new(#006622, 0) : hot ? #B9F6CA : color.lime) :
                 (light ? color.new(#991111, 0) : hot ? #FFFFFF : color.red)

            table.cell(lTable, c + 0, rr, ' ' + array.get(jSym, i) + ' ', bgcolor = rowBg, text_color = rowFg, text_size = logTxt)
            table.cell(lTable, c + 1, rr, ' ' + slotGlyph(g) + ' ' + str.tostring(slotLen(g)) + ' ', bgcolor = rowBg,
                 text_color = rowFg, text_size = logTxtBig)
            table.cell(lTable, c + 2, rr, ' ' + str.format_time(array.get(jOpen, i), 'MM-dd HH:mm', 'UTC+1') + ' ', bgcolor = rowBg, text_color = rowFg, text_size = logTxt)
            table.cell(lTable, c + 3, rr, ' ' + str.format_time(array.get(jTime, i), 'MM-dd HH:mm', 'UTC+1') + ' ', bgcolor = rowBg, text_color = rowFg, text_size = logTxt)
            table.cell(lTable, c + 4, rr, ' ' + str.tostring(en) + (enCont > 0 ? ' ✚' : '') + ' ', bgcolor = rowBg, text_color = rowFg, text_size = logTxt)
            table.cell(lTable, c + 5, rr, sd == 2 ? ' ▲ ' : sd == 1 ? ' ▼ ' : ' ', bgcolor = rowBg,
                 text_color = sideFg, text_size = logTxt)
    else if full
        table.cell(lTable, 0, 2, ' nothing closed in this window ', bgcolor = color.new(#333333, 60),
             text_color = color.silver, text_size = logTxt)

// ---------------------------------------------------------------------------
// The bridge - state published for the browser
// ---------------------------------------------------------------------------
// The scanner knows which pairs have a window open; the browser extension knows
// which pairs still pay enough. They meet nowhere, because Pine runs on
// TradingView's servers and cannot read a file, a cookie, localStorage or the
// network. There is no channel INTO Pine at all.
//
// Out of Pine there is exactly one: the status line, which is DOM. So the state
// of every slot goes out as numbers and the extension does the merge.
//
// EIGHT MACHINES, ONE DIGIT. The extension's question is about a PAIR - can I
// trade this symbol right now - and a pair has eight machines on it here. The
// digit is therefore the most advanced state any of the eight has reached, in the
// order running > armed > pre-armed > idle. That is a deliberate flattening: the
// line names pairs, and the gate that is deepest is the one that decides whether
// the pair is worth being on.
//
// THE ALPHABET IS mar1Scanner.pine's, unchanged, so one reader can serve both:
//
//   1  not in the scan - tick box off, or the symbol is blank
//   2  idle
//   6  idle AND pre-armed - on the white step, nothing open
//   3  armed
//   4  running
//   5  no data - the ticker did not resolve
//
// AND THE NUMBER CARRIES A 7 IN FRONT. mar1Scanner.pine publishes exactly ten
// digits, all inside the alphabet, and the reader finds its values by that shape
// rather than by position. A second scanner publishing the same shape on the
// same chart would give the reader six states where it expects three, and it
// would report a parse failure - correctly, but uselessly. The leading 7 makes
// these eleven digits instead of ten, so the two are told apart by shape as
// well, and either can be read alone or both together.
//
// The failure mode if only one side is updated is the good one: an extension
// that does not know about the 7 simply does not match, and says 'parse' rather
// than reading a gates state as something else.
digitFor(bool on, string raw, float v1, float v2, float v3, float v4, float v5, float v6, float v7, float v8) =>
    if not (on and raw != '') or not tfOk
        1
    else if na(v1)
        5
    else
        // Ranked 0..3 rather than compared as alphabet digits, because the
        // alphabet is not ordered: 6 is a refinement of 2 and sits between idle
        // and armed, so max() over the published digits would rank a pre-armed
        // pair above a running one.
        // AND THE TICK BOX IS READ HERE TOO, which is the fourth and last place.
        // This digit is what leaves the script - a watchlist column standing
        // where the tables are not - so a pair published as RUNNING on the
        // strength of a gate the grid has stopped drawing would be the one place
        // the switch could still be contradicted, and it would be contradicted
        // where nothing is on screen to explain it.
        int best = 0
        for s = 0 to 7
            if slotOn(s)
                vv = s == 0 ? v1 : s == 1 ? v2 : s == 2 ? v3 : s == 3 ? v4 :
                     s == 4 ? v5 : s == 5 ? v6 : s == 6 ? v7 : v8
                r = uEnt(vv) > 0 ? 3 : uOpen(vv) == 1 ? 2 : uStep(vv) == 1 ? 1 : 0
                if r > best
                    best := r
            // 3 is the top of the rank - no later slot can raise it, so the
            // remaining unpacks are dead work. Same answer, sooner.
            if best == 3
                break
        best == 3 ? 4 : best == 2 ? 3 : best == 1 ? 6 : 2

// Slot 1 is the most significant digit, so the row reads left to right in the
// same order the settings dialog lists it.
pack(int d1, int d2, int d3, int d4, int d5, int d6, int d7, int d8, int d9, int d10) =>
    d1 * 1000000000 + d2 * 100000000 + d3 * 10000000 + d4 * 1000000 + d5 * 100000 +
     d6 * 10000 + d7 * 1000 + d8 * 100 + d9 * 10 + d10


gstate1 = 70000000000 + pack(digitFor(use01, sym01, g01_1, g01_2, g01_3, g01_4, g01_5, g01_6, g01_7, g01_8),
     digitFor(use02, sym02, g02_1, g02_2, g02_3, g02_4, g02_5, g02_6, g02_7, g02_8),
     digitFor(use03, sym03, g03_1, g03_2, g03_3, g03_4, g03_5, g03_6, g03_7, g03_8),
     digitFor(use04, sym04, g04_1, g04_2, g04_3, g04_4, g04_5, g04_6, g04_7, g04_8),
     digitFor(use05, sym05, g05_1, g05_2, g05_3, g05_4, g05_5, g05_6, g05_7, g05_8),
     digitFor(use06, sym06, g06_1, g06_2, g06_3, g06_4, g06_5, g06_6, g06_7, g06_8),
     digitFor(use07, sym07, g07_1, g07_2, g07_3, g07_4, g07_5, g07_6, g07_7, g07_8),
     digitFor(use08, sym08, g08_1, g08_2, g08_3, g08_4, g08_5, g08_6, g08_7, g08_8),
     digitFor(use09, sym09, g09_1, g09_2, g09_3, g09_4, g09_5, g09_6, g09_7, g09_8),
     digitFor(use10, sym10, g10_1, g10_2, g10_3, g10_4, g10_5, g10_6, g10_7, g10_8))

gstate2 = 70000000000 + pack(digitFor(use11, sym11, g11_1, g11_2, g11_3, g11_4, g11_5, g11_6, g11_7, g11_8),
     digitFor(use12, sym12, g12_1, g12_2, g12_3, g12_4, g12_5, g12_6, g12_7, g12_8),
     digitFor(use13, sym13, g13_1, g13_2, g13_3, g13_4, g13_5, g13_6, g13_7, g13_8),
     digitFor(use14, sym14, g14_1, g14_2, g14_3, g14_4, g14_5, g14_6, g14_7, g14_8),
     digitFor(use15, sym15, g15_1, g15_2, g15_3, g15_4, g15_5, g15_6, g15_7, g15_8),
     digitFor(use16, sym16, g16_1, g16_2, g16_3, g16_4, g16_5, g16_6, g16_7, g16_8),
     digitFor(use17, sym17, g17_1, g17_2, g17_3, g17_4, g17_5, g17_6, g17_7, g17_8),
     digitFor(use18, sym18, g18_1, g18_2, g18_3, g18_4, g18_5, g18_6, g18_7, g18_8),
     digitFor(use19, sym19, g19_1, g19_2, g19_3, g19_4, g19_5, g19_6, g19_7, g19_8),
     digitFor(use20, sym20, g20_1, g20_2, g20_3, g20_4, g20_5, g20_6, g20_7, g20_8))

gstate3 = 70000000000 + pack(digitFor(use21, sym21, g21_1, g21_2, g21_3, g21_4, g21_5, g21_6, g21_7, g21_8),
     digitFor(use22, sym22, g22_1, g22_2, g22_3, g22_4, g22_5, g22_6, g22_7, g22_8),
     digitFor(use23, sym23, g23_1, g23_2, g23_3, g23_4, g23_5, g23_6, g23_7, g23_8),
     digitFor(use24, sym24, g24_1, g24_2, g24_3, g24_4, g24_5, g24_6, g24_7, g24_8),
     digitFor(use25, sym25, g25_1, g25_2, g25_3, g25_4, g25_5, g25_6, g25_7, g25_8),
     digitFor(use26, sym26, g26_1, g26_2, g26_3, g26_4, g26_5, g26_6, g26_7, g26_8),
     digitFor(use27, sym27, g27_1, g27_2, g27_3, g27_4, g27_5, g27_6, g27_7, g27_8),
     digitFor(use28, sym28, g28_1, g28_2, g28_3, g28_4, g28_5, g28_6, g28_7, g28_8),
     digitFor(use29, sym29, g29_1, g29_2, g29_3, g29_4, g29_5, g29_6, g29_7, g29_8),
     digitFor(use30, sym30, g30_1, g30_2, g30_3, g30_4, g30_5, g30_6, g30_7, g30_8))

// The checksum of the pair list, and it exists because the extension has to keep
// its own copy of the thirty names - Pine plot titles are constant strings and
// cannot be built from an input, so a plot can be called GSTATE1 but never
// EURUSD. The extension therefore knows "slot 7 is running" and not which pair
// that is until the list is pasted into it once.
//
// Checking that paste by LENGTH does not work: a count of live slots moves when
// a slot is unticked, without anything being wrong, and length cannot see a
// reordering at all. This sum is sensitive to both composition and order, and it
// is computed exactly as mar1Scanner.pine computes it - the extension has one
// implementation and it has to serve both files.
LIST_ALPHABET = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789'

symScore(bool on, string raw, int slotIndex) =>
    total = 0
    if on and raw != ''
        name = shortName(raw)
        for j = 0 to str.length(name) - 1
            // str.pos returns na for a character outside the alphabet, which nz
            // turns into 0 - an unknown character contributes nothing rather
            // than poisoning the whole sum with na.
            total += nz(str.pos(LIST_ALPHABET, str.substring(name, j, j + 1)))
    total * slotIndex

// Computed once and held. The list cannot change without the settings changing,
// and a settings change reloads the script.
var int listSum = na
if na(listSum)
    raw = symScore(use01, sym01, 1) + symScore(use02, sym02, 2) + symScore(use03, sym03, 3) +
         symScore(use04, sym04, 4) + symScore(use05, sym05, 5) + symScore(use06, sym06, 6) +
         symScore(use07, sym07, 7) + symScore(use08, sym08, 8) + symScore(use09, sym09, 9) +
         symScore(use10, sym10, 10) + symScore(use11, sym11, 11) + symScore(use12, sym12, 12) +
         symScore(use13, sym13, 13) + symScore(use14, sym14, 14) + symScore(use15, sym15, 15) +
         symScore(use16, sym16, 16) + symScore(use17, sym17, 17) + symScore(use18, sym18, 18) +
         symScore(use19, sym19, 19) + symScore(use20, sym20, 20) + symScore(use21, sym21, 21) +
         symScore(use22, sym22, 22) + symScore(use23, sym23, 23) + symScore(use24, sym24, 24) +
         symScore(use25, sym25, 25) + symScore(use26, sym26, 26) + symScore(use27, sym27, 27) +
         symScore(use28, sym28, 28) + symScore(use29, sym29, 29) + symScore(use30, sym30, 30)
    // 99991 is the largest prime under 100000, so the sum always fits in five
    // digits and cannot be mistaken for a packed state.
    listSum := raw % 99991

plot(gstate1, 'GSTATE1', color = color.new(color.teal, 0), display = display.status_line + display.data_window)
plot(gstate2, 'GSTATE2', color = color.new(color.teal, 0), display = display.status_line + display.data_window)
plot(gstate3, 'GSTATE3', color = color.new(color.teal, 0), display = display.status_line + display.data_window)

// The sign carries whether this is the LIVE bar, and that is not a trick for its
// own sake - it closes a hole the status line has by design.
//
// TradingView's status line shows the values of the bar under the CROSSHAIR, not
// of the last bar. Park the mouse anywhere on the chart and the legend reports
// history, and a reader parsing that legend has no way to tell from the digits
// alone - a state is a state whichever bar it came from. It would quietly report
// a four-hour-old picture as current.
//
// barstate.islast is false on every bar except the live one, so a negative
// checksum means "you are looking at history". It costs no extra plot and no
// extra token to locate: the reader already reads this number, and the sign was
// free.
plot(barstate.islast ? listSum : -listSum, 'LISTSUM', color = color.new(color.teal, 0),
  display = display.status_line + display.data_window)

// ---------------------------------------------------------------------------
// The closed log as TEXT - the way it gets off the screen
// ---------------------------------------------------------------------------
// Until this block the only way to read this log off the chart was to photograph
// it. mar1Scanner.pine has had two text channels for months - log.info lines and
// thirty CSV plots - and this file, which carries eight machines instead of one
// and is the harder of the two to read by eye, had NEITHER. Every question about
// what the day actually did therefore ended in a screenshot and in counting rows
// with a finger, which is slow, and worse, silently wrong: a misread row is
// indistinguishable from a correct one.
//
// So the whole surviving log goes to the Pine Logs panel as plain semicolon
// lines, once, and `checks/closed-chains.js` reads them.
//
// WHY IT IS DUMPED WHOLE AT THE END, and not written as each closure arrives.
// The dedup in logPair REMOVES rows retroactively - a window that opened earlier
// and finished later evicts everything it overlaps - so a line written at the
// moment of storage would describe a log that no longer exists by the time the
// day is over. A line cannot be taken back once it is in the panel. Dumping the
// arrays at the end is the only version that is guaranteed to equal the table:
// same rows, same order, same numbers, no reconciliation.
//
// barstate.islastconfirmedhistory fires EXACTLY ONCE, on the last closed bar of
// history. barstate.islast would fire on every realtime tick and fill the panel
// with a hundred copies of the same day. The cost of the choice is that the dump
// is one bar behind the live edge, which for reading a day back is nothing.
//
// THE FORMAT - one line per surviving row, oldest first:
//
//   GCLOSE;7;GBPUSD;B1:27;2026-07-29 12:00;2026-07-29 12:30;6;long;2026-07-29 11:52
//
//   1  row number, 1 = oldest, so a line can be referred to by name
//   2  pair
//   3  which machine: gate letter, 1 best length or 2 second, then the length
//   4  opened - the FIRST ENTRY, the same instant the Opened column prints and
//      the same instant maRejection.pine stamps on the chart
//   5  closed - the winning candle
//   6  entries the window cost
//   7  side
//   8  when the GATE opened - the green diamond. Never printed in the table; it
//      is the key the dedup ranks by, and it is here because it is the only
//      field that explains why a row is present and its neighbour is not.
//
// Oldest first, which is the REVERSE of the arrays and of the table. The table
// is read newest-first because the newest row is the one you have not seen; a
// file is read forwards, and every question asked of it so far has been about
// what followed what.
//
// One header line goes first, so a paste can be checked against the table
// without trusting either:
//
//   GCLOSEHDR;<from>;<to>;<rows>;<entries>;<slots live>
//
// The panel is in the Pine Editor, under 'Pine Logs'. Select the lines, copy,
// paste into a file, run the reader over it.
logToPanel = input.bool(true, 'Write the closed log to Pine Logs', group = gOut,
     tooltip = 'One line per surviving row, dumped once at the end of history. Open the Pine Editor, switch to the Pine Logs tab, select and copy. This is the only text channel out of this script - the tables cannot be exported any other way. Declared last in the file so that adding it moved no saved setting.', display = display.none)

if logToPanel and barstate.islastconfirmedhistory and array.size(jSym) > 0
    entSum = 0
    for i = 0 to array.size(jEnt) - 1
        entSum += array.get(jEnt, i)

    log.info('GCLOSEHDR;' + str.format_time(periodFrom, 'yyyy-MM-dd HH:mm', 'UTC+1') +
         ';' + str.format_time(periodTo, 'yyyy-MM-dd HH:mm', 'UTC+1') +
         ';' + str.tostring(array.size(jSym)) + ';' + str.tostring(entSum) +
         ';' + str.tostring(gatesLive))

    // Counting DOWN, because the arrays are newest first and the file is read
    // oldest first. A Pine for loop whose start exceeds its end counts
    // downwards by itself - which is also why the whole block sits behind a
    // size test: at size 0 this would be `for i = -1 to 0`, counting UP into an
    // index that does not exist.
    for i = array.size(jSym) - 1 to 0
        s = array.get(jGate, i)
        log.info('GCLOSE;' + str.tostring(array.size(jSym) - i) +
             ';' + array.get(jSym, i) +
             ';' + (s < 2 ? 'A' : s < 4 ? 'B' : s < 6 ? 'C' : 'D') + (s % 2 == 0 ? '1' : '2') +
             ':' + str.tostring(slotLen(s)) +
             ';' + (array.get(jOpen, i) > 0 ? str.format_time(array.get(jOpen, i), 'yyyy-MM-dd HH:mm', 'UTC+1') : '') +
             ';' + str.format_time(array.get(jTime, i), 'yyyy-MM-dd HH:mm', 'UTC+1') +
             ';' + str.tostring(array.get(jEnt, i)) +
             ';' + (array.get(jSide, i) == 2 ? 'long' : array.get(jSide, i) == 1 ? 'short' : '') +
             ';' + (array.get(jRank, i) > 0 ? str.format_time(array.get(jRank, i), 'yyyy-MM-dd HH:mm', 'UTC+1') : ''))

