//@version=6
indicator('C2', overlay=true)

// ———— Inputs ———— //
showPreIndicator = input.bool(true, 'Show  Pre-Direction Symbol')
startHour = input.int(4, "Start indicator's hours")
endHour = input.int(16, "End indicator'ss hours")
basePercentage = input.float(99.99, "Percentage", step=0.05)
minEntriesToStart = input.int(10, "Min entries to start (floor for calculateIndex)", minval=1)
conditionVersion = input.int(2, "Condition to enteres to the market (from 1 to 11)")
showFailedAfterSuccessTable = input.bool(false, "Show 'Fails After Success' Table")
showSuccessedAfterFailTable= input.bool(false, "Show 'Successes After Fail' Table")
showStatsTables = input.bool(true, "Show statistics tables")

maLength = input.int(5, title="MA Length")
maType = input.string("RMA", "MA Type", options=["SMA", "EMA", "WMA", "RMA"])
src = input(ohlc4, title="Source")
evaluationBars = input.int(1, "Bars to evaluate after signal", minval=1)

// MA Calculation
maValue = maType == "WMA" ? ta.wma(src, maLength) :
     maType == "EMA" ? ta.ema(src, maLength) :
     maType == "RMA" ? ta.rma(src, maLength) :
     ta.sma(src, maLength)

lineWidthForMA = 0
if conditionVersion == 8
    lineWidthForMA := 2
    
plot(maValue, title="MA", color=color.blue, linewidth=lineWidthForMA)

// Extra indicator Signal Calculations
x1 = ((close+low)*(open+high))
y1 = ((close+high)*(open+low))
spike = (x1/y1)
spikeReverse = (y1/x1)

// ———— Bullish/Bearish Conditions ———— //
isBullishBar = open < close
isBearishBar = open > close

buySignal8 = low <= maValue and open > maValue and close > maValue
sellSignal8 = high >= maValue and open < maValue and close < maValue



trendCCI = ta.cci(close, 170)
entryCCI = ta.cci(close, 89)
rsi = ta.rsi(close, 34)

buySignal9 = trendCCI > 0 and entryCCI > 0 and rsi > 55
sellSignal9 = trendCCI < 0 and entryCCI < 0 and rsi < 45

buySignal10 = (not isBearishBar)  and trendCCI > 0 and entryCCI > 0// and  rsi > 55
sellSignal10 = (not isBullishBar) and trendCCI < 0 and entryCCI < 0// and rsi < 45

buySignal11 = (not isBearishBar)  and trendCCI > 0 and entryCCI > 0 and  rsi > 55 
sellSignal11 = (not isBullishBar) and trendCCI < 0 and entryCCI < 0 and  rsi < 45 
// --- Signal Logic ---



// ———— Signal Conditions ———— //
buyCondition1 = (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBullishBar[7] and isBearishBar[8]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6])
buyCondition2 = (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar[1] and isBullishBar[2] and isBearishBar[3]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBullishBar[7] and isBearishBar[8]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4] and isBearishBar[5])
buyCondition3 = (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or(isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5])
buyCondition4 = (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[1] and isBearishBar[5]) or (isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4])
buyCondition5 = (isBearishBar[1] and isBullishBar[2] and isBullishBar[3])
buyCondition6 = spike[3+evaluationBars] < 1 and spike[2+evaluationBars] >= 1 and (close[evaluationBars]-open[evaluationBars])>0 //and  maValue[evaluationBars] >= maValue[evaluationBars+1]
buyCondition7 = spikeReverse[3+evaluationBars] < 1 and spikeReverse[2+evaluationBars] >= 1 and (close[evaluationBars]-open[evaluationBars])>0 //and  maValue[evaluationBars] >= maValue[evaluationBars+1]
buyCondition8 = buySignal8[1]
buyCondition9 = buySignal9[1] 
buyCondition10 = buySignal10[1]
buyCondition11 = buySignal11[1]

// Sell condition: high ≥ MA AND open < ma AND close < ma


sellCondition1 = (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBearishBar[7] and isBullishBar[8]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6])
sellCondition2 = (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar[1] and isBearishBar[2] and isBullishBar[3]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBearishBar[7] and isBullishBar[8]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4] and isBullishBar[5])
sellCondition3 = (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and  isBullishBar[5]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or(isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or(isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5])
sellCondition4 = (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[1] and isBullishBar[5]) or (isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4])
sellCondition5 = (isBullishBar[1] and isBearishBar[2] and isBearishBar[3])
sellCondition6 =  spike[3+evaluationBars] > 1 and spike[2+evaluationBars] <= 1  and (close[evaluationBars]-open[evaluationBars])<0 //and  maValue[evaluationBars] =< maValue[evaluationBars+1] 
sellCondition7 = spikeReverse[3+evaluationBars] > 1 and spikeReverse[2+evaluationBars] <= 1  and (close[evaluationBars]-open[evaluationBars])<0 //and  maValue[evaluationBars] =< maValue[evaluationBars+1] 
sellCondition8 = sellSignal8[1]
sellCondition9 = sellSignal9[1]
sellCondition10 = sellSignal10[1]
sellCondition11 = sellSignal11[1]

// Opposite direction after some same direction
oppositeBullish1 = (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5])
oppositeBullish2 = (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3]) or (isBullishBar and isBearishBar[1] and isBullishBar[2]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBullishBar[3]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBearishBar[6] and isBullishBar[7]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and isBullishBar[6]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3] and isBullishBar[4])
oppositeBullish3 = (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and  isBullishBar[5]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBearishBar[5] and  isBullishBar[6]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and isBullishBar[5]) or (isBullishBar and isBullishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4])
oppositeBullish4 = (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBearishBar[4] and  isBullishBar[5]) or (isBullishBar and isBearishBar[1] and isBearishBar[2] and isBearishBar[3] and isBullishBar[4]) or (isBullishBar and isBearishBar[1] and isBearishBar[2]  and isBullishBar[3])
oppositeBullish5 = (isBullishBar and isBearishBar[1] and isBearishBar[2])
oppositeBullish6 = spike[3+evaluationBars -1] > 1 and spike[2+evaluationBars-1] <= 1  and (close[evaluationBars-1]-open[evaluationBars-1])<=0 //and  maValue < maValue[1]//and close > close[evaluationBars]//(spike[3] > 1 and spike[2] <= 1)  //and  maValue < maValue[1])// and not isBullishBar
oppositeBullish7 = spikeReverse[3+evaluationBars -1] > 1 and spikeReverse[2+evaluationBars-1] <= 1  and (close[evaluationBars-1]-open[evaluationBars-1])<=0 //and  maValue < maValue[1]//and close > close[evaluationBars]//(spike[3] > 1 and spike[2] <= 1)  //and  maValue < maValue[1])// and not isBullishBar
oppositeBullish8 =  sellSignal8[1] and close[1] >= close
oppositeBullish9 =  (sellSignal9[1]) and close[1] >= close
oppositeBullish10 = sellSignal10[1] and close[1] >= close
oppositeBullish11 = sellSignal11 and close[1] >= close

oppositeBearish1 = (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5])
oppositeBearish2 = (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3]) or (isBearishBar and isBullishBar[1] and isBearishBar[2]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBearishBar[3]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBullishBar[6] and isBearishBar[7]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBearishBar[1] and isBearishBar[2] and isBullishBar[3] and isBearishBar[4])
oppositeBearish3 = (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and  isBearishBar[5]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBearishBar[3]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBullishBar[5] and isBearishBar[6]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and isBearishBar[5]) or (isBearishBar and isBearishBar[1] and isBullishBar[2] and isBullishBar[3] and  isBearishBar[4])
oppositeBearish4 = (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBullishBar[4] and  isBearishBar[5]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and isBullishBar[3] and isBearishBar[4]) or (isBearishBar and isBullishBar[1] and isBullishBar[2] and  isBearishBar[3])
oppositeBearish5 = (isBearishBar and isBullishBar[1] and isBullishBar[2])
oppositeBearish6 =  spike[3+evaluationBars-1] < 1 and spike[2+evaluationBars-1] >= 1 and (close[evaluationBars-1]-open[evaluationBars-1])>=0 //and  maValue > maValue[1] //and close < close[evaluationBars]//(spike[3] < 1 and spike[2] >= 1) //and  maValue > maValue[1])// and not isBearishBar
oppositeBearish7 = spikeReverse[3+evaluationBars-1] < 1 and spikeReverse[2+evaluationBars-1] >= 1 and (close[evaluationBars-1]-open[evaluationBars-1])>=0 //and  maValue > maValue[1] //and close < close[evaluationBars]//(spike[3] < 1 and spike[2] >= 1) //and  maValue > maValue[1])// and not isBearishBar
oppositeBearish8 = buySignal8[1] and close[1] <= close
oppositeBearish9 = (buySignal9[1]) and close[1] <= close
oppositeBearish10 = buySignal10[1] and close[1] <= close
oppositeBearish11 = buySignal11 and close[1] <= close

buyCondition = buyCondition1
sellCondition = sellCondition1
oppositeBullish = oppositeBullish1
oppositeBearish = oppositeBearish1

if (conditionVersion == 2)
    buyCondition := buyCondition2
    sellCondition := sellCondition2
    oppositeBullish := oppositeBullish2
    oppositeBearish := oppositeBearish2
else if (conditionVersion == 3)
    buyCondition := buyCondition3
    sellCondition := sellCondition3
    oppositeBullish := oppositeBullish3
    oppositeBearish := oppositeBearish3
else if (conditionVersion == 4)
    buyCondition := buyCondition4
    sellCondition := sellCondition4
    oppositeBullish := oppositeBullish4
    oppositeBearish := oppositeBearish4
else if (conditionVersion == 5)
    buyCondition := buyCondition5
    sellCondition := sellCondition5
    oppositeBullish := oppositeBullish5
    oppositeBearish := oppositeBearish5
else if (conditionVersion == 6)
    buyCondition := buyCondition6
    sellCondition := sellCondition6
    oppositeBullish := oppositeBullish6
    oppositeBearish := oppositeBearish6
else if (conditionVersion == 7)
    buyCondition := buyCondition7
    sellCondition := sellCondition7
    oppositeBullish := oppositeBullish7
    oppositeBearish := oppositeBearish7
else if (conditionVersion == 8)
    buyCondition := buyCondition8
    sellCondition := sellCondition8
    oppositeBullish := oppositeBullish8
    oppositeBearish := oppositeBearish8
else if (conditionVersion == 9)
    buyCondition := buyCondition9
    sellCondition := sellCondition9
    oppositeBullish := oppositeBullish9
    oppositeBearish := oppositeBearish9
else if (conditionVersion == 10)
    buyCondition := buyCondition10
    sellCondition := sellCondition10
    oppositeBullish := oppositeBullish10
    oppositeBearish := oppositeBearish10
else if (conditionVersion == 11)
    buyCondition := buyCondition11
    sellCondition := sellCondition11
    oppositeBullish := oppositeBullish11
    oppositeBearish := oppositeBearish11

// ———— Performance Tracking ———— //
var int totalBuySignals = 0
var int successfulBuySignals = 0
var int totalSellSignals = 0
var int successfulSellSignals = 0

// Track consecutive false signals
var int consecutiveBuyFalse = 0
var int maxConsecutiveBuyFalse = 0
var int consecutiveSellFalse = 0
var int maxConsecutiveSellFalse = 0
var int consecutiveCombinedFalse = 0
var int maxConsecutiveCombinedFalse = 0

// Track consecutive successful signals
var int consecutiveBuySuccess = 0
var int maxConsecutiveBuySuccess = 0
var int consecutiveSellSuccess = 0
var int maxConsecutiveSellSuccess = 0
var int consecutiveCombinedSuccess = 0
var int maxConsecutiveCombinedSuccess = 0

// False Accuracy tracking
var int totalFalseSignals = 0

// Last 15 Signals Tracking
var array<string> last15Signals = array.new_string(15)
var array<string> last15Results = array.new_string(15)

// Arrays to track failed signals after success
var int[] buyFailedAfterSuccess = array.new_int(20, 0)
var int[] sellFailedAfterSuccess = array.new_int(20, 0)
var int[] combinedFailedAfterSuccess = array.new_int(20, 0)

var int currentBuyFailedAfterSuccess = 0
var int currentSellFailedAfterSuccess = 0
var int currentCombinedFailedAfterSuccess = 0

// Arrays to track successes after fail
var int[] buySuccessesAfterFailed = array.new_int(20, 0)
var int[] sellSuccessesAfterFailed = array.new_int(20, 0)
var int[] combinedSuccessesAfterFailed = array.new_int(20, 0)

var int currentBuySuccessesAfterFailed = 0
var int currentSellSuccessesAfterFailed = 0
var int currentCombinedSuccessesAfterFailed = 0

isTradingHours = (hour + 1) % 24 >= startHour and (hour + 1) % 24 < endHour  // 8 AM to 8 PM UTC+1

// ———— Signal Validation ———— //
if buyCondition or sellCondition
    // Track buy signals
    if buyCondition
        totalBuySignals += 1
        signalResult = isBullishBar ? '1' : '0'
        array.unshift(last15Signals, 'BUY')
        array.unshift(last15Results, signalResult)
        array.pop(last15Signals)
        array.pop(last15Results)

        if isBullishBar
            successfulBuySignals += 1

            // Track successes after failures
            currentBuySuccessesAfterFailed += 1
            currentCombinedSuccessesAfterFailed += 1

            // Update arrays
            buyIdx = math.min(currentBuySuccessesAfterFailed, 19)
            array.set(buySuccessesAfterFailed, buyIdx, array.get(buySuccessesAfterFailed, buyIdx) + 1)
            if buyIdx > 0
                array.set(buySuccessesAfterFailed, buyIdx - 1, array.get(buySuccessesAfterFailed, buyIdx - 1) - 1)

            combIdx = math.min(currentCombinedSuccessesAfterFailed, 19)
            array.set(combinedSuccessesAfterFailed, combIdx, array.get(combinedSuccessesAfterFailed, combIdx) + 1)
            if combIdx > 0
                array.set(combinedSuccessesAfterFailed, combIdx - 1, array.get(combinedSuccessesAfterFailed, combIdx - 1) - 1)

            // Existing success streak tracking
            consecutiveBuyFalse := 0
            consecutiveBuySuccess += 1
            consecutiveCombinedSuccess += 1
            maxConsecutiveBuySuccess := math.max(maxConsecutiveBuySuccess, consecutiveBuySuccess)
            maxConsecutiveCombinedSuccess := math.max(maxConsecutiveCombinedSuccess, consecutiveCombinedSuccess)

            // Reset failed-after-success counters
            currentBuyFailedAfterSuccess := 0
            currentCombinedFailedAfterSuccess := 0

        else if isBearishBar
            currentBuySuccessesAfterFailed := 0
            currentCombinedSuccessesAfterFailed := 0
            consecutiveBuyFalse += 1
            consecutiveBuySuccess := 0
            consecutiveCombinedSuccess := 0
            maxConsecutiveBuyFalse := math.max(maxConsecutiveBuyFalse, consecutiveBuyFalse)

            // Reset successes-after-fail counters on new failure
            currentBuySuccessesAfterFailed := 0

            // Existing failed-after-success logic
            currentBuyFailedAfterSuccess += 1
            currentCombinedFailedAfterSuccess += 1
            buyIdx = math.min(currentBuyFailedAfterSuccess, 19)
            array.set(buyFailedAfterSuccess, buyIdx, array.get(buyFailedAfterSuccess, buyIdx) + 1)
            if buyIdx > 0
                array.set(buyFailedAfterSuccess, buyIdx - 1, array.get(buyFailedAfterSuccess, buyIdx - 1) - 1)
            combIdx = math.min(currentCombinedFailedAfterSuccess, 19)
            array.set(combinedFailedAfterSuccess, combIdx, array.get(combinedFailedAfterSuccess, combIdx) + 1)
            if combIdx > 0
                array.set(combinedFailedAfterSuccess, combIdx - 1, array.get(combinedFailedAfterSuccess, combIdx - 1) - 1)

    // Track sell signals
    if sellCondition
        totalSellSignals += 1
        signalResult = isBearishBar ? '1' : '0'
        array.unshift(last15Signals, 'SELL')
        array.unshift(last15Results, signalResult)
        array.pop(last15Signals)
        array.pop(last15Results)

        if isBearishBar
            successfulSellSignals += 1

            // Track successes after failures
            currentSellSuccessesAfterFailed += 1
            currentCombinedSuccessesAfterFailed += 1

            // Update arrays
            sellIdx = math.min(currentSellSuccessesAfterFailed, 19)
            array.set(sellSuccessesAfterFailed, sellIdx, array.get(sellSuccessesAfterFailed, sellIdx) + 1)
            if sellIdx > 0
                array.set(sellSuccessesAfterFailed, sellIdx - 1, array.get(sellSuccessesAfterFailed, sellIdx - 1) - 1)

            combIdx = math.min(currentCombinedSuccessesAfterFailed, 19)
            array.set(combinedSuccessesAfterFailed, combIdx, array.get(combinedSuccessesAfterFailed, combIdx) + 1)
            if combIdx > 0
                array.set(combinedSuccessesAfterFailed, combIdx - 1, array.get(combinedSuccessesAfterFailed, combIdx - 1) - 1)

            // Existing success streak tracking
            consecutiveSellFalse := 0
            consecutiveSellSuccess += 1
            consecutiveCombinedSuccess += 1
            maxConsecutiveSellSuccess := math.max(maxConsecutiveSellSuccess, consecutiveSellSuccess)
            maxConsecutiveCombinedSuccess := math.max(maxConsecutiveCombinedSuccess, consecutiveCombinedSuccess)

            // Reset failed-after-success counters
            currentSellFailedAfterSuccess := 0
            currentCombinedFailedAfterSuccess := 0

        else if isBullishBar
            currentSellSuccessesAfterFailed := 0
            currentCombinedSuccessesAfterFailed := 0
            consecutiveSellFalse += 1
            consecutiveSellSuccess := 0
            consecutiveCombinedSuccess := 0
            maxConsecutiveSellFalse := math.max(maxConsecutiveSellFalse, consecutiveSellFalse)

            // Reset successes-after-fail counters on new failure
            currentSellSuccessesAfterFailed := 0

            // Existing failed-after-success logic
            currentSellFailedAfterSuccess += 1
            currentCombinedFailedAfterSuccess += 1
            sellIdx = math.min(currentSellFailedAfterSuccess, 19)
            array.set(sellFailedAfterSuccess, sellIdx, array.get(sellFailedAfterSuccess, sellIdx) + 1)
            if sellIdx > 0
                array.set(sellFailedAfterSuccess, sellIdx - 1, array.get(sellFailedAfterSuccess, sellIdx - 1) - 1)
            combIdx = math.min(currentCombinedFailedAfterSuccess, 19)
            array.set(combinedFailedAfterSuccess, combIdx, array.get(combinedFailedAfterSuccess, combIdx) + 1)
            if combIdx > 0
                array.set(combinedFailedAfterSuccess, combIdx - 1, array.get(combinedFailedAfterSuccess, combIdx - 1) - 1)

    // Track combined false streak
    if (buyCondition and isBearishBar) or (sellCondition and isBullishBar)
        totalFalseSignals += 1
        consecutiveCombinedFalse += 1
        maxConsecutiveCombinedFalse := math.max(maxConsecutiveCombinedFalse, consecutiveCombinedFalse)
    else if (buyCondition and isBullishBar) or (sellCondition and isBearishBar)
        consecutiveCombinedFalse := 0

// ———— Trading Hours Configuration ———— //
utcOffset = 1 // UTC+1 (Central European Time)

// Convert UTC to local time (UTC+1)
localHour = (hour + utcOffset) % 24

// ———— Visual Feedback ———— //
bgcolor(
     (localHour >= startHour and localHour < endHour) ?
     color.new(color.green, 97) :
     color.new(color.red, 100),
     title="Trading Hours Background")

// ———— Create Tables ———— //
// Performance table (24 rows: 7 metrics + 17 signal history)
var table perfTable = table.new(position.bottom_left, 4, 26, border_width=2)

// Failed After Success table (top_right) / Successes After Fail table (bottom_right)
var table failedAfterSuccessTable = table.new(position.top_right, 4, 22, border_width=2)
var table successedAfterFailTable = table.new(position.bottom_right, 4, 22, border_width=2)

getLastNonZeroIndex(array) =>
    int lastIndex = -1  // Default: not found
    // PineScript v6 requires positive step, so we count up and calculate reverse index
    for i = 0 to array.size(array) - 1
        reverseIndex = array.size(array) - 1 - i
        if array.get(array, reverseIndex) != 0
            lastIndex := reverseIndex
            break  // Exit loop once found
    lastIndex  // Returns -1 if no non-zero value exists
if barstate.islast and showStatsTables
    // Calculate metrics
    // 100.0 leads every ratio on purpose: int / int is integer division in Pine,
    // which would collapse each of these percentages to exactly 0% or 100%.
    buyAccuracy = totalBuySignals > 0 ? 100.0 * successfulBuySignals / totalBuySignals : na
    sellAccuracy = totalSellSignals > 0 ? 100.0 * successfulSellSignals / totalSellSignals : na
    totalSignals = totalBuySignals + totalSellSignals
    totalSuccessful = successfulBuySignals + successfulSellSignals
    totalAccuracy = totalSignals > 0 ? 100.0 * totalSuccessful / totalSignals : na
    // Guarded by totalSignals, not by totalFalseSignals: the share of false
    // signals is a meaningful 0% once signals exist, and only undefined while
    // there are none at all.
    falseAccuracy = totalSignals > 0 ? 100.0 * totalFalseSignals / totalSignals : na

    // ———— Performance Table (Left) ———— //
    startRow = 0

    // Table title
    table.cell(perfTable, 0, startRow, ' PERFORMANCE ', bgcolor=color.black, text_color=color.white, width=4)

    // Metrics headers
    table.cell(perfTable, 0, startRow + 1, ' Metric ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 1, startRow + 1, ' Buy ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 2, startRow + 1, ' Sell ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 3, startRow + 1, ' Combined ', bgcolor=color.gray, text_color=color.white)

    // Basic Metrics (rows 2-6)
    table.cell(perfTable, 0, startRow + 2, ' Signals ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, startRow + 2, str.tostring(totalBuySignals), bgcolor=color.new(#005500, 80), text_color=color.white)
    table.cell(perfTable, 2, startRow + 2, str.tostring(totalSellSignals), bgcolor=color.new(#550000, 80), text_color=color.white)
    table.cell(perfTable, 3, startRow + 2, str.tostring(totalSignals), bgcolor=color.new(#333399, 80), text_color=color.white)

    table.cell(perfTable, 0, startRow + 3, ' Successful ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, startRow + 3, str.tostring(successfulBuySignals), bgcolor=color.new(#005500, 80), text_color=color.white)
    table.cell(perfTable, 2, startRow + 3, str.tostring(successfulSellSignals), bgcolor=color.new(#550000, 80), text_color=color.white)
    table.cell(perfTable, 3, startRow + 3, str.tostring(totalSuccessful), bgcolor=color.new(#333399, 80), text_color=color.white)

    table.cell(perfTable, 0, startRow + 4, ' Accuracy ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, startRow + 4, not na(buyAccuracy) ? str.tostring(buyAccuracy, '#.##') + '%' : 'N/A', bgcolor=color.new(#00AA00, 80), text_color=color.white)
    table.cell(perfTable, 2, startRow + 4, not na(sellAccuracy) ? str.tostring(sellAccuracy, '#.##') + '%' : 'N/A', bgcolor=color.new(#AA0000, 80), text_color=color.white)
    table.cell(perfTable, 3, startRow + 4, not na(totalAccuracy) ? str.tostring(totalAccuracy, '#.##') + '%' : 'N/A', bgcolor=color.new(#5555FF, 80), text_color=color.white)

    // False Accuracy row
    table.cell(perfTable, 0, startRow + 5, ' False Accuracy ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, startRow + 5, '', bgcolor=color.new(#333333, 70)) // Empty for Buy column
    table.cell(perfTable, 2, startRow + 5, '', bgcolor=color.new(#333333, 70)) // Empty for Sell column
    table.cell(perfTable, 3, startRow + 5, not na(falseAccuracy) ? str.tostring(falseAccuracy, '#.##') + '%' : 'N/A', bgcolor=color.new(#333333, 70),text_color=color.white)
    table.cell(perfTable, 0, startRow + 6, ' Max False Streak ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, startRow + 6, str.tostring(maxConsecutiveBuyFalse), bgcolor=color.new(#005500, 80), text_color=color.white)
    table.cell(perfTable, 2, startRow + 6, str.tostring(maxConsecutiveSellFalse), bgcolor=color.new(#550000, 80), text_color=color.white)
    // Combined column reports the same quantity as Buy/Sell: the longest streak
    // actually observed. getLastNonZeroIndex over the histogram answered a
    // different question and did not belong in this row.
    table.cell(perfTable, 3, startRow + 6, str.tostring(maxConsecutiveCombinedFalse), bgcolor=color.new(#333399, 80), text_color=color.white)

    // Max Success Streak
    table.cell(perfTable, 0, 7, ' Max Success Streak ', bgcolor=color.new(#333333, 70), text_color=color.white)
    table.cell(perfTable, 1, 7, str.tostring(maxConsecutiveBuySuccess), bgcolor=color.new(#00AA00, 80), text_color=color.white)
    table.cell(perfTable, 2, 7, str.tostring(maxConsecutiveSellSuccess), bgcolor=color.new(#AA0000, 80), text_color=color.white)
    table.cell(perfTable, 3, 7, str.tostring(maxConsecutiveCombinedSuccess), bgcolor=color.new(#5555FF, 80), text_color=color.white)

    // Spacer row
    table.cell(perfTable, 0, 8, '', bgcolor=color.black)
    table.cell(perfTable, 1, 8, '', bgcolor=color.black)
    table.cell(perfTable, 2, 8, '', bgcolor=color.black)
    table.cell(perfTable, 3, 8, '', bgcolor=color.black)

    // Signal history
    signalHistoryStart = startRow + 9

    // Signal history header
    table.cell(perfTable, 0, signalHistoryStart, ' Last 15 Signals ', bgcolor=color.black, text_color=color.white, width=4)
    table.cell(perfTable, 0, signalHistoryStart + 1, ' # ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 1, signalHistoryStart + 1, ' Type ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 2, signalHistoryStart + 1, ' Result ', bgcolor=color.gray, text_color=color.white)
    table.cell(perfTable, 3, signalHistoryStart + 1, ' Confirmation ', bgcolor=color.gray, text_color=color.white)

    // Signal history rows (15 signals)
    for i = 0 to 14
        if i < array.size(last15Signals)
            signalType = array.get(last15Signals, i)
            result = array.get(last15Results, i)
            confirmation = signalType == 'BUY' ? result == '1' ? 'Bullish' : 'Not Bullish' : result == '1' ? 'Bearish' : 'Not Bearish'
            rowBgColor = result == '1' ? signalType == 'BUY' ? color.new(#005500, 70) : color.new(#550000, 70) : color.new(#333333, 70)

            table.cell(perfTable, 0, signalHistoryStart + 2 + i, str.tostring(i + 1), bgcolor=rowBgColor, text_color=color.white)
            table.cell(perfTable, 1, signalHistoryStart + 2 + i, signalType, bgcolor=rowBgColor, text_color=color.white)
            table.cell(perfTable, 2, signalHistoryStart + 2 + i, result, bgcolor=rowBgColor, text_color=color.white)
            table.cell(perfTable, 3, signalHistoryStart + 2 + i, confirmation, bgcolor=rowBgColor, text_color=color.white)

// auxiliar function for calculate ratios
calculateIndex(arr, perc) =>
    // Calculate total sum of the array
    total = 0.0
    for i = 1 to array.size(arr) - 1
        total += array.get(arr, i)

    // Return -1 if array is empty or total is zero
    if array.size(arr) == 0 or total == 0
        -1
    else
        // Calculate cumulative percentage and find the index
        cumSum = 0.0
        index = -1
        for i = 1 to array.size(arr) - 1
            cumSum += array.get(arr, i) / total * 100
            if cumSum > perc and index == -1
                index := i
        index

// ———— Failed After Success Table (Right) ———— //
if barstate.islast and showFailedAfterSuccessTable
    table.cell(failedAfterSuccessTable, 0, 0, ' FAILS AFTER SUCCESS ', bgcolor=color.black, text_color=color.white, width=7)

    // Headers
    table.cell(failedAfterSuccessTable, 0, 1, ' Signals After Success ', bgcolor=color.gray, text_color=color.white)
    table.cell(failedAfterSuccessTable, 1, 1, ' Count ', bgcolor=color.gray, text_color=color.white)
    table.cell(failedAfterSuccessTable, 2, 1, ' Percentage ', bgcolor=color.gray, text_color=color.white)
    table.cell(failedAfterSuccessTable, 3, 1, ' Cumulative ', bgcolor=color.gray, text_color=color.white)

    // Calculate total fails
    totalFails = 0
    for i = 1 to 19
        totalFails += array.get(combinedFailedAfterSuccess, i)

    // Store all percentages
    var float[] failPcts = array.new_float(22, 0)
    cumulativeFails = 0

    for i = 1 to 19
        fails = array.get(combinedFailedAfterSuccess, i)
        cumulativeFails += fails
        failPct = totalFails > 0 ? 100.0 * fails / totalFails : 0
        array.set(failPcts, i, failPct)

    var int bestRatioIndex = 0

    bestRatioIndex := calculateIndex(combinedFailedAfterSuccess, basePercentage)

    // Build the table
    cumulativeFails := 0
    for i = 1 to 19
        fails = array.get(combinedFailedAfterSuccess, i)
        cumulativeFails += fails
        failPct = array.get(failPcts, i)
        cumPct = totalFails > 0 ? 100.0 * cumulativeFails / totalFails : 0

        // Determine row color
        rowColor = color.new(#333333, 70 - i * 3)

        // Highlight max ratio row
        ratioCellColor = i == bestRatioIndex ? color.new(color.green, 70) : rowColor
        ratioTextColor = i == bestRatioIndex ? color.yellow : color.white

        // Table cells
        table.cell(failedAfterSuccessTable, 0, i + 1, str.tostring(i), bgcolor=ratioCellColor, text_color=color.white)
        table.cell(failedAfterSuccessTable, 1, i + 1, str.tostring(fails), bgcolor=ratioCellColor, text_color=color.white)
        table.cell(failedAfterSuccessTable, 2, i + 1, str.tostring(failPct, '#.##') + '%', bgcolor=ratioCellColor, text_color=color.white)
        table.cell(failedAfterSuccessTable, 3, i + 1, str.tostring(cumPct, '#.##') + '%', bgcolor=ratioCellColor, text_color=ratioTextColor)

    // Summary row
    table.cell(failedAfterSuccessTable, 0, 21, ' Total Fails ', bgcolor=color.gray, text_color=color.white)
    table.cell(failedAfterSuccessTable, 1, 21, str.tostring(totalFails), bgcolor=color.gray, text_color=color.white)
    table.cell(failedAfterSuccessTable, 2, 21, '', bgcolor=color.gray)
    table.cell(failedAfterSuccessTable, 3, 21, '100%', bgcolor=color.gray, text_color=color.white)

if barstate.islast and showSuccessedAfterFailTable
    table.cell(successedAfterFailTable, 0, 0, ' SUCCESSES AFTER FAIL ', bgcolor=color.black, text_color=color.white, width=7)

    // Headers
    table.cell(successedAfterFailTable, 0, 1, ' Signals After Fail ', bgcolor=color.gray, text_color=color.white)
    table.cell(successedAfterFailTable, 1, 1, ' Count ', bgcolor=color.gray, text_color=color.white)
    table.cell(successedAfterFailTable, 2, 1, ' Percentage ', bgcolor=color.gray, text_color=color.white)
    table.cell(successedAfterFailTable, 3, 1, ' Cumulative ', bgcolor=color.gray, text_color=color.white)

    // Calculate total successes after fail
    totalSuccessesAfterFail = 0
    for i = 1 to 19
        totalSuccessesAfterFail += array.get(combinedSuccessesAfterFailed, i)

    // Store all percentages
    var float[] successPcts = array.new_float(22, 0)
    cumulativeSuccesses = 0

    for i = 1 to 19
        successes = array.get(combinedSuccessesAfterFailed, i)
        cumulativeSuccesses += successes
        successPct = totalSuccessesAfterFail > 0 ? 100.0 * successes / totalSuccessesAfterFail : 0
        array.set(successPcts, i, successPct)

    var int bestRatioIndex = 0

    bestRatioIndex := calculateIndex(combinedSuccessesAfterFailed, basePercentage)

    // Build the table
    cumulativeSuccesses := 0
    for i = 1 to 19
        successes = array.get(combinedSuccessesAfterFailed, i)
        cumulativeSuccesses += successes
        successPct = array.get(successPcts, i)
        cumPct = totalSuccessesAfterFail > 0 ? 100.0 * cumulativeSuccesses / totalSuccessesAfterFail : 0

        // Determine row color
        rowColor = color.new(#333333, 70 - i * 3)

        // Highlight max ratio row
        ratioCellColor = i == bestRatioIndex ? color.new(color.green, 70) : rowColor
        ratioTextColor = i == bestRatioIndex ? color.yellow : color.white

        // Table cells
        table.cell(successedAfterFailTable, 0, i + 1, str.tostring(i), bgcolor=ratioCellColor, text_color=color.white)
        table.cell(successedAfterFailTable, 1, i + 1, str.tostring(successes), bgcolor=ratioCellColor, text_color=color.white)
        table.cell(successedAfterFailTable, 2, i + 1, str.tostring(successPct, '#.##') + '%', bgcolor=ratioCellColor, text_color=color.white)
        table.cell(successedAfterFailTable, 3, i + 1, str.tostring(cumPct, '#.##') + '%', bgcolor=ratioCellColor, text_color=ratioTextColor)

    // Summary row
    table.cell(successedAfterFailTable, 0, 21, ' Total Successes ', bgcolor=color.gray, text_color=color.white)
    table.cell(successedAfterFailTable, 1, 21, str.tostring(totalSuccessesAfterFail), bgcolor=color.gray, text_color=color.white)
    table.cell(successedAfterFailTable, 2, 21, '', bgcolor=color.gray)
    table.cell(successedAfterFailTable, 3, 21, totalSuccessesAfterFail > 0 ? '100%' : '0%', bgcolor=color.gray, text_color=color.white)

// ———— Color Functions with Time Filter ———— //
getSignalColor(bool isBuy, int streak, int limit) =>
    float intensity =  1.0 * streak / limit
    baseColor = isBuy ? #008877 : #cc0011
    
    // Color blending
    r = color.r(baseColor) + (255 - color.r(baseColor)) * math.min(intensity * 1.5, 1)
    g = color.g(baseColor) + (255 - color.g(baseColor)) * math.min(intensity * 1.5, 1)
    b = color.b(baseColor) + (255 - color.b(baseColor)) * math.min(intensity * 1.5, 1)
    
    // Pre-orange and orange states
    //if intensity >= preOrangeThreshold and intensity < 1
    //    color.lime
    //else if intensity >= 1
    //    color.orange
    streakComparisionValue =  limit
    
    if streak == streakComparisionValue - 1 
        color.white
    else if streak == streakComparisionValue
        color.lime
    else if streak > streakComparisionValue
    //if streak > streakComparisionValue
        if streak - streakComparisionValue < 2
            color.orange
        else if streak - streakComparisionValue < 3
            color.rgb(121, 119, 236)
        else if streak - streakComparisionValue < 15
            color.purple
        else
            color.rgb(5, 188, 243)
    //else
    //    alpha = math.round(255 * (1 - math.min(intensity / limit, 1)))
    //    color.new(color.rgb(r, g, b), alpha)
        //color.rgb(r, g, b)

getOppositeSignalColor(int streak, int limit) =>
    float intensity =  1.0 * streak / limit
    baseColor = #00aaff
    
    r = color.r(baseColor) + (255 - color.r(baseColor)) * math.min(intensity * 1.5, 1)
    g = color.g(baseColor) + (255 - color.g(baseColor)) * math.min(intensity * 1.5, 1)
    b = color.b(baseColor) + (255 - color.b(baseColor)) * math.min(intensity * 1.5, 1)
    
     //if intensity >= preOrangeThreshold and intensity < 1
    //    color.lime
    //else if intensity >= 1
    //    color.orange
    streakComparisionValue =  limit
    if streak == streakComparisionValue - 1 
        color.white
    else if streak == streakComparisionValue
        color.lime
    else if streak > streakComparisionValue
    //if streak > streakComparisionValue
        if streak - streakComparisionValue < 2
            color.orange
        else if streak - streakComparisionValue < 3
            color.rgb(121, 119, 236)     
        else if streak - streakComparisionValue < 15
            color.purple
        else
            color.rgb(5, 188, 243)
    //else
    //    alpha = math.round(255 * (1 - math.min(intensity/limit, 1)))
    //    color.new(color.rgb(r, g, b), alpha)
    //    color.rgb(r, g, b)


//a = array.new_int()
preferedEnterForFails = minEntriesToStart //math.max(calculateIndex(combinedSuccessesAfterFailed, basePercentage), minEntriesToStart)
preferedEnterForSuccesses = minEntriesToStart //math.max(calculateIndex(combinedFailedAfterSuccess, basePercentage), minEntriesToStart)
//a.push(preferedEnterForSuccesses)
//a.push(preferedEnterForFails)
//pp.print_array_float(a)
// ———— Plot Current Signals ———— //
//if(preferedEnterForSuccesses > 0 and preferedEnterForFails > 0)
plotshape(buyCondition, 'Buy Signal', shape.diamond, location.belowbar, 
  color=getSignalColor(true, consecutiveCombinedFalse, preferedEnterForFails), size=size.tiny)
plotshape(sellCondition, 'Sell Signal', shape.diamond, location.abovebar , 
  color=getSignalColor(false, consecutiveCombinedFalse, preferedEnterForFails), size=size.tiny)

plotshape(buyCondition, 'Buy Signal', shape.diamond, location.abovebar, 
  color=getOppositeSignalColor(consecutiveCombinedSuccess, preferedEnterForSuccesses), size=size.tiny)
plotshape(sellCondition, 'Sell Signal', shape.diamond, location.belowbar, 
  color=getOppositeSignalColor(consecutiveCombinedSuccess, preferedEnterForSuccesses), size=size.tiny)

// Plot opposite direction figure
plotshape(showPreIndicator and oppositeBullish, "Opposite Bullish", shape.diamond, location.abovebar, 
  color=getSignalColor(false, consecutiveCombinedFalse, preferedEnterForFails), size=size.small)
plotshape(showPreIndicator and oppositeBearish, "Opposite Bearish", shape.diamond, location.belowbar, 
  color=getSignalColor(true, consecutiveCombinedFalse, preferedEnterForFails), size=size.small)
plotshape(showPreIndicator and oppositeBullish, "Opposite Bullish", shape.diamond, location.belowbar, 
  color=getOppositeSignalColor(consecutiveCombinedSuccess, preferedEnterForSuccesses), size=size.small)
plotshape(showPreIndicator and oppositeBearish, "Opposite Bearish", shape.diamond, location.abovebar, 
  color=getOppositeSignalColor(consecutiveCombinedSuccess, preferedEnterForSuccesses), size=size.small)

